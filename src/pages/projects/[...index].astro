---
import PageIntro from "../../components/PageIntro.astro";
import PreviewMorph from "../../components/PreviewMorph.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { GetStaticPaths } from "astro";
import { getPage, getProjects } from "../../lib/content.ts";
import { hasProjects } from "../../lib/sections.ts";

// A rest route, so the page can be left out: it's built only while there
// are projects (DESIGN.md §8).
export const getStaticPaths = (() =>
  hasProjects
    ? [{ params: { index: undefined } }]
    : []) satisfies GetStaticPaths;

const [page, projects] = await Promise.all([
  getPage("projects"),
  getProjects(),
]);
// With an odd count, the first project spans both columns.
const wide = projects.length % 2 === 1;
---

<BaseLayout title={page.title} description={page.intro} lastArrivalStep={1}>
  <PreviewMorph slot="head" />
  <div class="projects">
    <PageIntro title={page.title} intro={page.intro} />
    <ul class="grid enter" role="list" style="--i: 1">
      {projects.map((project, index) => (
        <ProjectCard project={project} wide={wide && index === 0} />
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12) var(--space-6);

    @media (width >= 40rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
