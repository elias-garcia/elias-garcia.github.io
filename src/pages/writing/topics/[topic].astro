---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import WritingInPlace from "../../../components/WritingInPlace.astro";
import WritingIndex from "../../../components/WritingIndex.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  getPage,
  getPosts,
  getProfile,
  getTopics,
} from "../../../lib/content.ts";
import { fill } from "../../../lib/template.ts";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return [...getTopics(posts).values()].map((topic) => ({
    params: { topic: topic.slug },
    props: { topic, posts },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { topic, posts } = Astro.props;
const [page, topicPage, profile] = await Promise.all([
  getPage("writing"),
  getPage("writing-topic"),
  getProfile(),
]);
const values = { topic: topic.label, name: profile.name };
---

<BaseLayout
  title={fill(topicPage.title, values)}
  description={fill(topicPage.intro, values)}
  lastArrivalStep={3}
>
  <WritingInPlace slot="head" />
  <WritingIndex page={page} posts={posts} topic={topic} />
</BaseLayout>
