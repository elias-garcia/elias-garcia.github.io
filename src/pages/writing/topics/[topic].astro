---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import WritingInPlace from "../../../components/WritingInPlace.astro";
import WritingIndex from "../../../components/WritingIndex.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPage, getPosts, getTopics } from "../../../lib/content.ts";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return [...getTopics(posts).values()].map((topic) => ({
    params: { topic: topic.slug },
    props: { topic, posts },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { topic, posts } = Astro.props;
const [page, topicPage] = await Promise.all([
  getPage("writing"),
  getPage("writing-topic"),
]);
const fill = (text: string) => text.replaceAll("{topic}", topic.label);
---

<BaseLayout title={fill(topicPage.title)} description={fill(topicPage.intro)}>
  <WritingInPlace slot="head" />
  <WritingIndex page={page} posts={posts} topic={topic} />
</BaseLayout>
