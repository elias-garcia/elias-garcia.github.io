---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import AuthorFooter from "../../components/AuthorFooter.astro";
import BackLink from "../../components/BackLink.astro";
import CopyButton from "../../components/CopyButton.astro";
import DisplayTitle from "../../components/DisplayTitle.astro";
import Icon from "../../components/Icon.astro";
import MetaItem from "../../components/MetaItem.astro";
import MetaLine from "../../components/MetaLine.astro";
import { mdxComponents } from "../../components/mdx/index.ts";
import Prose from "../../components/mdx/Prose.astro";
import PreviousNext from "../../components/PreviousNext.astro";
import StructuredData from "../../components/StructuredData.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getPage,
  getPostCopy,
  getPosts,
  getProfile,
  getReadingTime,
  getTopics,
  topicLabel,
} from "../../lib/content.ts";
import { formatLongDate, formatMediumDate, isoDate } from "../../lib/format.ts";
import { requireSite, toPath } from "../../lib/navigation.ts";
import { blogPosting } from "../../lib/structured-data.ts";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const topics = getTopics(posts);
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      topics,
      // Posts are newest first: the previous post is the older one.
      previous: posts[index + 1],
      next: posts[index - 1],
    },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, topics, previous, next } = Astro.props;
const { title, description, date, topic } = post.data;
const [{ Content }, readingTime, profile, writing, copy] = await Promise.all([
  render(post),
  getReadingTime(post),
  getProfile(),
  getPage("writing"),
  getPostCopy(),
]);
const label = topicLabel(topics, topic);
const markdown = `/writing/${post.id}.md`;
const shareImage = `/share/writing/${post.id}.png`;
const siteUrl = requireSite(Astro.site, "structured data");
const structuredData = blogPosting(
  post,
  label,
  profile,
  siteUrl,
  new URL(toPath(Astro.url.pathname), siteUrl),
  new URL(shareImage, siteUrl),
);
---

<BaseLayout
  title={title}
  description={description}
  readingProgress
  shareImage={{ path: shareImage, alt: title }}
  article={{ published: isoDate(date) }}
>
  <link slot="head" rel="alternate" type="text/markdown" href={markdown} />
  <StructuredData slot="head" data={structuredData} />
  <article class="post">
    <div class="reading">
      <div class="head">
        <div class="top">
          <BackLink href="/writing" label={writing.title} />
          <CopyButton
            label={copy.copyPage}
            name={copy.copyPageName}
            url={markdown}
          >
            <Icon name="markdown" />
          </CopyButton>
        </div>
        <header class="intro">
          <DisplayTitle>{title}</DisplayTitle>
          <p class="meta">
            <MetaLine>
              <MetaItem>
                <time datetime={isoDate(date)}>
                  <span class="long">{formatLongDate(date)}</span>
                  <span class="short">{formatMediumDate(date)}</span>
                </time>
              </MetaItem>
              <MetaItem>
                <a
                  class="topic"
                  href={`/writing/topics/${topic.slug}`}
                  aria-label={`More posts about ${label}`}
                >
                  {label}
                </a>
              </MetaItem>
              <MetaItem>{readingTime}</MetaItem>
            </MetaLine>
          </p>
        </header>
      </div>
      <Prose>
        <Content components={mdxComponents} />
      </Prose>
    </div>
    <div class="end">
      <AuthorFooter name={profile.name} role={profile.role} />
      <PreviousNext
        name="More posts"
        previous={
          previous && {
            href: `/writing/${previous.id}`,
            title: previous.data.title,
            label: "Previous post",
          }
        }
        next={
          next && {
            href: `/writing/${next.id}`,
            title: next.data.title,
            label: "Next post",
          }
        }
      />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .reading,
  .end {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .meta {
    color: var(--text-3);
    font-size: var(--text-small);
  }

  .short {
    display: none;
  }

  @media (width < 40rem) {
    .long {
      display: none;
    }

    .short {
      display: inline;
    }
  }

  .topic {
    color: var(--text-3);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: var(--underline-offset);
    transition:
      color var(--dur) var(--ease),
      text-decoration-color var(--dur) var(--ease);

    &:focus-visible {
      color: var(--text);
      text-decoration-color: currentColor;
    }

    @media (hover: hover) and (pointer: fine) {
      &:hover {
        color: var(--text);
        text-decoration-color: currentColor;
      }
    }
  }
</style>
