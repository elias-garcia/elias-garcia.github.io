---
import { Font } from "astro:assets";
import Analytics from "../components/Analytics.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SearchDialog from "../components/SearchDialog.astro";
import SkipLink from "../components/SkipLink.astro";
import { getFeedTitle, getProfile } from "../lib/content.ts";
import { formatCountry } from "../lib/format.ts";
import { requireSite, toPath } from "../lib/navigation.ts";
import { routes } from "../lib/routes.ts";
import { shareImageSize } from "../lib/share-image.ts";
import { fill } from "../lib/template.ts";
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  readingProgress?: boolean;
  // The page's own share image; by default, the site's.
  shareImage?: { path: string; alt: string };
  // A post: shared as an article, with its date (ISO 8601).
  article?: { published: string };
};

const {
  title,
  description,
  readingProgress = false,
  shareImage: pageShareImage,
  article,
} = Astro.props;
const [profile, feedTitle] = await Promise.all([getProfile(), getFeedTitle()]);
const path = toPath(Astro.url.pathname);
const siteUrl = requireSite(Astro.site, "canonical and share image URLs");
const canonical = new URL(path, siteUrl);
// The page first, then the site; Home is the site, so its title stands
// alone. Social cards show the site's name on their own, so they get the
// page alone.
const documentTitle =
  path === routes.home
    ? title
    : fill(profile.pageTitle, { page: title, name: profile.name });
// Its script only exists on Vercel deployments (previews included):
// elsewhere (astro dev, astro preview, Lighthouse) it would be a missing file.
const onVercel = process.env.VERCEL === "1";
const shareImage = pageShareImage ?? {
  path: routes.shareImage,
  alt: fill(profile.shareAlt, { name: profile.name, role: profile.role }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit: the page and the phone image viewer paint under a notch
         and pad back out (DESIGN.md §2.9). interactive-widget: on Android the
         keyboard resizes the search panel instead of covering it. Zoom is
         never disabled. -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="color-scheme" content="light dark" />
    <!-- Text follows the reader's system text size (DESIGN.md §8). -->
    <meta name="text-scale" content="scale" />
    <!-- The page transition's opt-in is inline, ahead of the stylesheets:
         Chrome looks for it on the new page before a linked stylesheet
         applies, and skips the transition when it isn't there yet. -->
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
    </style>
    <!-- The first render, and with it a page transition, waits until the
         content is parsed: the block lifts at the footer's opening tag, which
         follows the content. -->
    <link rel="expect" href="#footer" blocking="render" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={article ? "article" : "website"} />
    {article && (
      <meta property="article:published_time" content={article.published} />
    )}
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL(shareImage.path, siteUrl)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(shareImageSize.width)} />
    <meta property="og:image:height" content={String(shareImageSize.height)} />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={shareImage.alt} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href={routes.sitemap} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={feedTitle}
      href={routes.feed}
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#09090b"
    />

    <Font cssVariable="--font-sans" preload />
    <script is:inline>
      // The search shortcut is ⌘K on Apple's systems and Ctrl K elsewhere;
      // set before the first render so the header button doesn't change.
      // No API says which modifier a keyboard has, so the system is read
      // from the user agent: every browser keeps it there.
      if (!/Mac|iPhone|iPad|iPod/.test(navigator.userAgent)) {
        document.documentElement.dataset.shortcut = "other";
      }
    </script>
    <slot name="head" />
    {onVercel && <Analytics />}
  </head>
  <body>
    <SkipLink />
    <Header name={profile.name} readingProgress={readingProgress} />
    <main id="content">
      <slot />
    </main>
    <Footer
      name={profile.name}
      country={formatCountry(profile.country)}
      timezone={profile.timezone}
    />
    <SearchDialog />
  </body>
</html>

<style>
  main {
    flex: 1 0 auto;
    inline-size: 100%;
    max-inline-size: var(--column);
    margin-inline: auto;
    padding: var(--space-page) var(--page-end) 0 var(--page-start);
    animation: page-in var(--dur-slow) var(--ease-settle) backwards;

    :global(:root[data-in-place]) & {
      animation: none;
    }

    @media (prefers-reduced-motion: reduce) {
      animation: page-fade var(--dur) var(--ease-settle) backwards;
    }
  }
</style>
