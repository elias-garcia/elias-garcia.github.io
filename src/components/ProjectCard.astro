---
import type { CollectionEntry } from "astro:content";
import { getProjectCopy, hasCaseStudy } from "../lib/content.ts";
import { routes } from "../lib/routes.ts";
import Icon from "./Icon.astro";
import ProjectPreview from "./ProjectPreview.astro";
import ProjectStatus from "./ProjectStatus.astro";

type Props = {
  project: CollectionEntry<"projects">;
  // On Home: a level-three title, the short summary and no "View project".
  tile?: boolean;
  // The first project spans the grid from 640px when the count is odd.
  wide?: boolean;
};

const { project, tile = false, wide = false } = Astro.props;
const { title, summary, description, status, year, illustration } =
  project.data;
const href = hasCaseStudy(project) ? routes.project(project.id) : undefined;
const copy = await getProjectCopy();
const Tag = href === undefined ? "div" : "a";
---

<li class:list={["cell", { wide }]}>
  <Tag class="card" href={href}>
    <ProjectPreview illustration={illustration} wide={wide} />
    <div class="head">
      {tile ? (
        <h3 class="title">{title}</h3>
      ) : (
        <div class="title-row">
          <h2 class="title">{title}</h2>
          {href !== undefined && (
            <span class="go">
              {copy.view}
              <Icon name="chevron-right" size="sm" class="chevron" />
            </span>
          )}
        </div>
      )}
      <ProjectStatus status={status} year={year} />
    </div>
    <p class="description">{tile ? summary : description}</p>
  </Tag>
</li>

<style>
  .cell,
  .card {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    align-content: start;
  }

  .wide {
    grid-column: 1 / -1;
  }

  /* The card sets its own row gap, so the page's grid gap only spaces
     cards apart. */
  .card {
    row-gap: var(--space-2);

    :global(.preview) {
      margin-block-end: var(--space-2);
    }
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
  }

  .title {
    font-size: inherit;
    font-weight: var(--weight-medium);
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  .description {
    color: var(--text-2);
  }

  .go {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-1);
    color: var(--text-2);
    font-size: var(--text-small);
    transition: color var(--dur) var(--ease);

    @media (width < 40rem) {
      display: none;
    }
  }

  /* The title follows the link colour; the label turns with it. */
  .card {
    &:focus-visible {
      border-radius: var(--r-lg);
      color: var(--accent);
    }

    &:focus-visible .go {
      color: var(--accent);
    }

    @media (hover: hover) and (pointer: fine) {
      &:hover .go {
        color: var(--accent);
      }
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .card:hover .chevron {
      translate: var(--nudge) 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .chevron {
      transition: translate var(--dur) var(--ease-settle);
    }
  }
</style>
