---
import { linkTarget } from "../lib/links.ts";

// A row in the search list. A link goes somewhere; without `href` the row is
// an action the dialog's script handles (`action`). The icon is the slot.
// Rows in a <template> start empty: a link row with an empty `href` renders
// a link without one (an empty `href` isn't a valid one), and the script
// fills the `data-` parts and the `href`.
type Props = {
  title?: string;
  line?: string;
  meta?: string;
  href?: string;
  download?: boolean;
  action?: string;
  keywords?: readonly string[];
  more?: boolean;
  // The line is an address: it may break, but never with a hyphen that
  // would read as part of it.
  address?: boolean;
};

const {
  title,
  line,
  meta,
  href,
  download = false,
  action,
  keywords,
  more = false,
  address = false,
} = Astro.props;
const Row = href === undefined ? "div" : "a";
---

<Row
  class="option"
  role="option"
  aria-selected="false"
  tabindex="-1"
  href={href === "" ? undefined : href}
  download={download || undefined}
  data-astro-prefetch={download ? "false" : undefined}
  data-action={action}
  data-keywords={keywords?.join(" ")}
  {...(href === undefined ? {} : linkTarget(href))}
>
  <span class="tile" aria-hidden="true">
    <slot />
  </span>
  <span class="text">
    <span class="title" data-title>
      {title}
    </span>
    <span class:list={["line", { address }]} data-line>
      {line}
    </span>
  </span>
  <span class="meta" data-meta>
    {meta}
  </span>
  <span class:list={["hint", { more }]} aria-hidden="true">
    {more ? "›" : "↵"}
  </span>
</Row>

<style>
  .option {
    --search-row-h: 48px;
    /* The title and summary lines: the icon, the meta and the hint are
       centred on them, so a row that wraps further keeps all of them on the
       title's level. In rem, so it grows with the text. */
    --search-two-lines: calc(
      (var(--text-body) + var(--text-small)) * var(--leading-tight)
    );

    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--search-row-h);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--r-md);
    color: var(--text);
    cursor: pointer;
    -webkit-user-select: none;
    user-select: none;

    @media (hover: hover) and (pointer: fine) {
      &:hover {
        color: var(--text);
      }
    }

    &[aria-selected="true"] {
      background: var(--tint);
    }

    /* Pressed on a touch screen, a row dims like the page's links, whether
       it's a link or an action (DESIGN.md §2.9). */
    @media (hover: none), (pointer: coarse) {
      transition: opacity var(--dur-quick) var(--ease-settle);

      &:active {
        opacity: var(--dim-press);
        transition: none;
      }
    }
  }

  .tile {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: var(--control-h);
    block-size: var(--control-h);
    border-radius: var(--r-md);
    background: var(--control);
    color: var(--text-2);

    align-self: start;
    margin-block-start: calc((var(--search-two-lines) - var(--control-h)) / 2);

    .option:has(.line:empty) & {
      align-self: center;
      margin-block-start: 0;
    }

    [aria-selected="true"] & {
      background: var(--bg);
      color: var(--accent);
    }
  }

  .text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-inline-size: 0;
    line-height: var(--leading-tight);
    /* A long unbroken word (a URL, a package name) breaks instead of
       running into the meta; with the text enlarged, with a hyphen. */
    overflow-wrap: anywhere;

    @media (width < 20em) {
      hyphens: auto;
    }
  }

  .address {
    hyphens: manual;
  }

  .line,
  .meta {
    color: var(--text-2);
    font-size: var(--text-small);

    &:empty {
      display: none;
    }
  }

  .meta {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* One line as tall as the title and summary, so each sits centred on
     them, like the icon. */
  .meta,
  .hint {
    align-self: start;
    line-height: var(--search-two-lines);

    .option:has(.line:empty) & {
      align-self: center;
      line-height: inherit;
    }
  }

  /* With the text this large, a date beside the title would leave it a
     word per line: the date moves under the summary, and the title gets
     the row's width beside the icon. The › stays on the right. */
  @media (width < 20em) {
    .option {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      row-gap: 0;
    }

    .meta {
      grid-row: 2;
      grid-column: 2;
      color: var(--text-3);
      line-height: var(--leading-tight);
      white-space: normal;
    }

    .hint {
      grid-row: 1;
      grid-column: 3;
    }

    /* A row with no summary (a topic and its post count): the count goes
       under the title the same way, and the icon is centred on both. */
    .option:has(.line:empty) {
      .tile {
        grid-row: 1 / span 2;
      }

      .meta {
        align-self: start;
        line-height: var(--leading-tight);
      }
    }
  }

  .hint {
    inline-size: var(--icon-md);
    color: var(--text-3);
    font-size: var(--text-small);
    opacity: 0;

    [aria-selected="true"] & {
      opacity: 1;
    }

    /* ↵ points at a key a touch screen doesn't have, and with large text
       the row needs the room; › still says a row opens more. */
    &:not(.more) {
      @media (width < 30em), (hover: none), (pointer: coarse) {
        display: none;
      }
    }
  }

  /* Matches in what the visitor typed. Text, not a background: a background
     all but disappears on the selected row's tint. The weight carries the
     match without relying on colour. */
  .option :global(mark) {
    background: none;
    color: var(--accent);
    font-weight: var(--weight-semibold);
  }

  /* The selected row's tint is gone in forced colours: an outline marks it. */
  @media (forced-colors: active) {
    .option[aria-selected="true"] {
      outline: var(--focus-ring) solid Highlight;
      outline-offset: calc(-1 * var(--focus-ring));
    }
  }
</style>
