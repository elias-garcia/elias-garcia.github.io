---
import type { CollectionEntry } from "astro:content";
import { workMode } from "../lib/content.ts";
import Icon from "./Icon.astro";
import VisuallyHidden from "./VisuallyHidden.astro";
import Years from "./Years.astro";

type Props = {
  job: CollectionEntry<"work">["data"];
  open: boolean;
};

const { job, open } = Astro.props;
---

<li>
  <details class="job row-interactive" open={open}>
    <summary class="head">
      <span class="date">
        <Years start={job.start} end={job.end} />
      </span>
      <span class="text">
        <span class="company-line">
          <span class="company">{job.company}</span>
          <span class="mode">
            <span class="separator" aria-hidden="true">
              ·
            </span>
            <VisuallyHidden>,</VisuallyHidden>
            {workMode(job)}
          </span>
        </span>
        <span class="role">{job.role}</span>
      </span>
      <Icon name="plus" class="plus" />
    </summary>
    <ul class="points" role="list">
      {job.points.map((point) => (
        <li>{point}</li>
      ))}
    </ul>
  </details>
</li>

<style>
  .job {
    transition: opacity var(--dur) var(--ease);
  }

  .head {
    display: grid;
    grid-template-areas: "date text icon";
    grid-template-columns: var(--gutter) minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-1) var(--space-6);
    padding-block: var(--space-3);
    list-style: none;
    cursor: pointer;

    &::-webkit-details-marker {
      display: none;
    }

    &:focus-visible {
      border-radius: var(--r-sm);
    }

    @media (width < 40rem) {
      grid-template-areas:
        "date icon"
        "text text";
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .date {
    grid-area: date;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .text {
    display: flex;
    grid-area: text;
    flex-direction: column;
  }

  .company {
    font-weight: var(--weight-medium);
  }

  /* Flex, so the markup's whitespace adds no space around the dot. */
  .company-line,
  .mode {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
  }

  .mode {
    color: var(--text-3);
    font-size: var(--text-small);
  }

  .separator {
    margin-inline: var(--space-2);
  }

  .role {
    color: var(--text-2);
  }

  .plus {
    grid-area: icon;
    margin-block-start: var(--space-1);
    stroke: var(--text-3);
    transition: stroke var(--dur) var(--ease);

    @media (hover: hover) and (pointer: fine) {
      .head:hover & {
        stroke: var(--text);
      }
    }

    .job[open] & {
      rotate: 45deg;
    }
  }

  .points {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 0 0 var(--space-4) calc(var(--gutter) + var(--space-6));
    color: var(--text-2);
    line-height: var(--leading-body);

    @media (width < 40rem) {
      padding-inline-start: 0;
    }

    li {
      position: relative;
      padding-inline-start: var(--space-4);

      &::before {
        content: "";
        position: absolute;
        /* Centred on the first line. */
        inset-block-start: calc((1lh - var(--space-1)) / 2);
        inset-inline-start: 0;
        inline-size: var(--space-1);
        block-size: var(--space-1);
        border-radius: 50%;
        background: var(--line-strong);
      }
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .plus {
      transition:
        stroke var(--dur) var(--ease),
        rotate var(--dur-slow) var(--ease-settle);
    }

    .job::details-content {
      interpolate-size: allow-keywords;
      overflow: clip;
      contain: layout;
      transition:
        block-size var(--dur-slow) var(--ease-settle),
        content-visibility var(--dur-slow),
        display var(--dur-slow);
      transition-behavior: allow-discrete;
    }

    .job:not([open])::details-content {
      block-size: 0;
    }
  }

  @media (forced-colors: active) {
    .points li::before {
      background: CanvasText;
    }
  }
</style>
