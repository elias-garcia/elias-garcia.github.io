---
import { viewerImage } from "../lib/attachment.ts";
import { getViewerCopy } from "../lib/content.ts";
import KeyHintGroup from "./KeyHintGroup.astro";

// The image viewer for the talk photos (RowPhotos.astro): a card over the
// page, and on phones a full-screen dark viewer.
const copy = await getViewerCopy();
---

<dialog
  class="viewer"
  closedby="any"
  data-viewer
  data-copy={JSON.stringify({
    label: copy.label,
    labelOne: copy.labelOne,
    position: copy.position,
  })}
>
  <button
    class="control close"
    type="button"
    aria-label={copy.close}
    autofocus
    data-viewer-close
  >
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="M4 4l8 8M12 4l-8 8"></path>
    </svg>
  </button>

  <figure class="figure">
    <div class="stage">
      <div class="frame" data-viewer-frame data-sizes={viewerImage.sizes}>
        <div class="track" data-viewer-track></div>
      </div>
      <button
        class="control arrow previous"
        type="button"
        aria-label={copy.previous}
        data-viewer-previous
        data-viewer-several
      >
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M10 3.5 5.5 8l4.5 4.5"></path>
        </svg>
      </button>
      <button
        class="control arrow next"
        type="button"
        aria-label={copy.next}
        data-viewer-next
        data-viewer-several
      >
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M6 3.5 10.5 8 6 12.5"></path>
        </svg>
      </button>
    </div>
    <figcaption class="caption">
      <span class="title" data-viewer-title></span>
      <span class="meta">
        <span data-viewer-where></span>
        <span class="dot" aria-hidden="true">
          ·
        </span>
        <span data-viewer-date></span>
        <span class="dot" aria-hidden="true" data-viewer-several>
          ·
        </span>
        <span
          class="position"
          aria-live="polite"
          data-viewer-position
          data-viewer-several
        ></span>
      </span>
    </figcaption>
  </figure>

  <div class="phone-nav" data-viewer-several>
    <button
      class="control"
      type="button"
      aria-label={copy.previous}
      data-viewer-previous
    >
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M10 3.5 5.5 8l4.5 4.5"></path>
      </svg>
    </button>
    <span class="dots" aria-hidden="true" data-viewer-dots></span>
    <button
      class="control"
      type="button"
      aria-label={copy.next}
      data-viewer-next
    >
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M6 3.5 10.5 8 6 12.5"></path>
      </svg>
    </button>
  </div>

  <div class="footer">
    <KeyHintGroup
      keys={[copy.hints.previous, copy.hints.next]}
      label={copy.hints.move}
      data-viewer-several
    />
    <KeyHintGroup keys={[copy.hints.escape]} label={copy.hints.close} />
  </div>
</dialog>

<script>
  import type createPanzoom from "@panzoom/panzoom";
  import type { PanzoomObject } from "@panzoom/panzoom";
  import { fill } from "../lib/template.ts";
  import {
    closeTopLayer,
    fadeOnCloseRequests,
    isClosing,
  } from "../lib/top-layer.ts";

  type Copy = { label: string; labelOne: string; position: string };

  function isCopy(value: unknown): value is Copy {
    return (
      typeof value === "object" &&
      value !== null &&
      "label" in value &&
      typeof value.label === "string" &&
      "labelOne" in value &&
      typeof value.labelOne === "string" &&
      "position" in value &&
      typeof value.position === "string"
    );
  }

  function isViewerEntry(state: unknown): boolean {
    return (
      typeof state === "object" &&
      state !== null &&
      "viewer" in state &&
      state.viewer === true
    );
  }

  // Gesture thresholds, in CSS pixels.
  const lockAfter = 8;
  const swipeToMove = 50;
  const dragToClose = 80;
  // Swiping past the first or last photo moves the row this much of the way.
  const resistance = 1 / 3;
  // How far a drag down goes before the backdrop is at its faintest.
  const fadeDistance = 480;
  const faintest = 0.4;
  // The smallest the viewer starts from, for a tiny thumbnail.
  const smallestScale = 0.2;

  const dialog = document.querySelector<HTMLDialogElement>("[data-viewer]");
  const frame = dialog?.querySelector<HTMLElement>("[data-viewer-frame]");
  const track = dialog?.querySelector<HTMLElement>("[data-viewer-track]");
  const title = dialog?.querySelector<HTMLElement>("[data-viewer-title]");
  const where = dialog?.querySelector<HTMLElement>("[data-viewer-where]");
  const date = dialog?.querySelector<HTMLElement>("[data-viewer-date]");
  const position = dialog?.querySelector<HTMLElement>("[data-viewer-position]");
  const dots = dialog?.querySelector<HTMLElement>("[data-viewer-dots]");
  const copy: unknown = JSON.parse(dialog?.dataset.copy ?? "null");

  if (
    dialog &&
    frame &&
    track &&
    title &&
    where &&
    date &&
    position &&
    dots &&
    isCopy(copy)
  ) {
    const phone = matchMedia("(width < 40rem)");
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const tokens = getComputedStyle(document.documentElement);
    // In milliseconds; the build may write a token in seconds.
    const duration = (token: string) => {
      const value = tokens.getPropertyValue(token).trim();
      const amount = Number.parseFloat(value);
      return value.endsWith("ms") ? amount : amount * 1000;
    };

    let photos: HTMLButtonElement[] = [];
    let images: HTMLImageElement[] = [];
    let opener: HTMLButtonElement | undefined;
    let current = 0;
    // The viewer adds a history entry when it opens, so Back closes it.
    // `ownsEntry`: the current entry is the viewer's. `goingBack`: the viewer
    // took its entry back and that Back hasn't landed yet.
    let ownsEntry = false;
    let goingBack = false;
    let talkTitle = "";
    let resize: Animation | undefined;
    let panzoom: typeof createPanzoom | undefined;
    const zooms = new Map<HTMLImageElement, PanzoomObject>();

    // On phones the photos sit in a row that slides; elsewhere, and with
    // reduced motion, they're stacked and crossfade.
    const slides = () => phone.matches && !reducedMotion.matches;

    // Panzoom only loads once a photo is opened, and only pinch-zooms: one
    // finger moves between photos or drags the viewer closed unless the
    // photo is zoomed in.
    const zoomable = (image: HTMLImageElement) => {
      if (panzoom === undefined || zooms.has(image)) {
        return;
      }
      zooms.set(
        image,
        panzoom(image, {
          minScale: 1,
          maxScale: 4,
          contain: "outside",
          panOnlyWhenZoomed: true,
          cursor: "auto",
          // The stylesheet decides: the card clips a zoomed photo, the phone
          // viewer lets it fill the screen.
          overflow: "",
        }),
      );
    };

    const loadZoom = async () => {
      try {
        panzoom ??= (await import("@panzoom/panzoom")).default;
      } catch {
        // Zoom is an extra: if Panzoom can't load (offline, say), the photo
        // doesn't zoom, and the next photo opened tries again.
        return;
      }
      const image = images[current];
      if (dialog.open && image !== undefined) {
        zoomable(image);
      }
    };

    const zoomedIn = () => {
      const image = images[current];
      return image !== undefined && (zooms.get(image)?.getScale() ?? 1) > 1;
    };

    const wrap = (index: number) => (index + photos.length) % photos.length;

    // Swaps the thumbnail for the larger photo once it's ready, once.
    const loading = new WeakSet<HTMLImageElement>();
    const load = (index: number) => {
      const photo = photos[index];
      const image = images[index];
      if (photo === undefined || image === undefined || loading.has(image)) {
        return;
      }
      loading.add(image);
      const large = new Image();
      large.sizes = image.sizes;
      large.srcset = photo.dataset.viewerSrcset ?? "";
      large.src = photo.dataset.viewerSrc ?? "";
      large
        .decode()
        .catch(() => {
          // Failed to load: swapping in shows the broken image's alt text.
        })
        .finally(() => {
          if (images[index] === image) {
            image.srcset = large.srcset;
            image.src = large.src;
            image.hidden = false;
          }
        });
    };

    // One slide per photo of the talk. Each shows its thumbnail, already on
    // the page, until the larger photo loads; a thumbnail that hasn't loaded
    // yet (it's lazy) shows nothing.
    const buildSlides = () => {
      for (const zoom of zooms.values()) {
        zoom.destroy();
      }
      zooms.clear();
      images = photos.map((photo) => {
        const thumbnail = photo.querySelector("img");
        const image = document.createElement("img");
        image.className = "image";
        image.sizes = frame.dataset.sizes ?? "";
        image.alt = thumbnail?.alt ?? "";
        const placeholder = thumbnail?.currentSrc ?? "";
        if (placeholder !== "") {
          image.src = placeholder;
        }
        image.hidden = placeholder === "";
        return image;
      });
      track.replaceChildren(
        ...images.map((image) => {
          const slide = document.createElement("div");
          slide.className = "slide";
          slide.append(image);
          return slide;
        }),
      );
    };

    const show = (index: number) => {
      const previous = images[current];
      if (previous !== undefined) {
        zooms.get(previous)?.reset({ animate: false });
      }
      current = wrap(index);
      for (const [index, slide] of [...track.children].entries()) {
        slide.classList.toggle("current", index === current);
        slide.setAttribute("aria-hidden", String(index !== current));
      }
      track.style.setProperty("--index", String(current));
      // The photo on screen, then its neighbours, ready to move to.
      for (const index of new Set([
        current,
        wrap(current + 1),
        wrap(current - 1),
      ])) {
        load(index);
      }
      const image = images[current];
      if (dialog.open && image !== undefined) {
        zoomable(image);
      }
      const values = {
        index: String(current + 1),
        count: String(photos.length),
        title: talkTitle,
      };
      dialog.setAttribute(
        "aria-label",
        fill(photos.length === 1 ? copy.labelOne : copy.label, values),
      );
      position.textContent = fill(copy.position, values);
      for (const [index, dot] of [...dots.children].entries()) {
        dot.classList.toggle("current", index === current);
      }
    };

    // The viewer grows out of a photo's thumbnail and shrinks back into it:
    // the scale is the thumbnail's width over the viewer's, around its
    // centre.
    const scaleFrom = (photo: HTMLButtonElement | undefined) => {
      const thumbnail = photo?.querySelector("img");
      if (thumbnail === null || thumbnail === undefined) {
        return undefined;
      }
      resize?.cancel();
      const box = dialog.getBoundingClientRect();
      const from = thumbnail.getBoundingClientRect();
      dialog.style.transformOrigin = `${String(from.left + from.width / 2 - box.left)}px ${String(from.top + from.height / 2 - box.top)}px`;
      return Math.max(smallestScale, Math.min(1, from.width / box.width));
    };

    const grow = () => {
      const scale = reducedMotion.matches ? undefined : scaleFrom(opener);
      if (scale !== undefined) {
        resize = dialog.animate([{ scale: String(scale) }, { scale: "1" }], {
          duration: duration("--dur-slow"),
          easing: tokens.getPropertyValue("--ease-settle").trim(),
        });
      }
    };

    // A thumbnail scrolled out of its strip (on phones) is no place to
    // shrink into.
    const inStrip = (photo: HTMLButtonElement | undefined) => {
      const strip = photo?.closest("[data-viewer-talk]");
      if (photo === undefined || strip === null || strip === undefined) {
        return false;
      }
      const box = photo.getBoundingClientRect();
      const bounds = strip.getBoundingClientRect();
      return box.left >= bounds.left - 1 && box.right <= bounds.right + 1;
    };

    // Into the thumbnail of the photo on screen, which may not be the one
    // that opened the viewer, or else the one that did. Only once: a second
    // close request during the fade leaves it be. The viewer's fade is the
    // stylesheet's.
    const shrink = () => {
      if (reducedMotion.matches || isClosing(dialog)) {
        return;
      }
      const photo = photos[current];
      const scale = scaleFrom(inStrip(photo) ? photo : opener);
      if (scale !== undefined) {
        resize = dialog.animate([{ scale: "1" }, { scale: String(scale) }], {
          duration: duration("--dur"),
          easing: tokens.getPropertyValue("--ease").trim(),
          fill: "forwards",
        });
      }
    };

    const endDrag = () => {
      delete dialog.dataset.dragging;
      dialog.style.removeProperty("--drag");
      dialog.style.removeProperty("--backdrop-fade");
    };

    const endSwipe = () => {
      delete dialog.dataset.swiping;
      track.style.removeProperty("--swipe");
    };

    // Dragged down to close, the viewer leaves from where it was dropped.
    const close = ({ dragged = false } = {}) => {
      if (!dragged) {
        shrink();
      }
      void closeTopLayer(dialog, () => {
        dialog.close();
      });
    };

    const open = (button: HTMLButtonElement) => {
      const talk = button.closest<HTMLElement>("[data-viewer-talk]");
      if (talk === null) {
        return;
      }
      opener = button;
      // The last close's shrink and drag stay until now, so the viewer could
      // fade out where it ended.
      resize?.cancel();
      endDrag();
      endSwipe();
      photos = [
        ...talk.querySelectorAll<HTMLButtonElement>("[data-viewer-open]"),
      ];
      talkTitle = talk.dataset.viewerTalk ?? "";
      title.textContent = talkTitle;
      where.textContent = talk.dataset.viewerWhere ?? "";
      date.textContent = talk.dataset.viewerDate ?? "";
      for (const element of dialog.querySelectorAll<HTMLElement>(
        "[data-viewer-several]",
      )) {
        element.hidden = photos.length === 1;
      }
      dots.replaceChildren(
        ...photos.map(() => {
          const dot = document.createElement("span");
          dot.className = "position-dot";
          return dot;
        }),
      );
      buildSlides();
      show(photos.indexOf(button));
      dialog.showModal();
      grow();
      // Back closes the viewer, as it does other full-screen overlays. Reopened
      // before the last close was handled, it keeps that entry; if the last
      // close's Back is still on its way, the new entry waits for it.
      if (!ownsEntry && !goingBack) {
        history.pushState({ viewer: true }, "");
        ownsEntry = true;
      }
      void loadZoom();
    };

    const move = (step: number) => {
      if (photos.length > 1) {
        show(current + step);
      }
    };

    const setDrag = (distance: number) => {
      dialog.style.setProperty("--drag", `${String(distance)}px`);
      dialog.style.setProperty(
        "--backdrop-fade",
        String(Math.max(faintest, 1 - distance / fadeDistance)),
      );
    };

    // Past the first or last photo, the row resists.
    const atEnd = (distance: number) =>
      (current === 0 && distance > 0) ||
      (current === photos.length - 1 && distance < 0);

    const setSwipe = (distance: number) => {
      dialog.dataset.swiping = "";
      track.style.setProperty(
        "--swipe",
        `${String(atEnd(distance) ? distance * resistance : distance)}px`,
      );
    };

    // The close event arrives a moment after the viewer closes, so it may
    // find the viewer open again.
    dialog.addEventListener("close", () => {
      if (dialog.open) {
        return;
      }
      const image = images[current];
      if (image !== undefined) {
        zooms.get(image)?.reset({ animate: false });
      }
      // Closed some other way than Back: take back the history entry, so the
      // next Back leaves the page as expected.
      if (ownsEntry) {
        ownsEntry = false;
        goingBack = true;
        history.back();
      }
      // Safari doesn't focus a button on click, so the browser can't return
      // focus to it. The page stays where it was, even with the photo under
      // the sticky header.
      opener?.focus({ preventScroll: true });
    });

    addEventListener("popstate", () => {
      if (goingBack) {
        goingBack = false;
        // Reopened before the Back landed: now add its entry.
        if (dialog.open) {
          history.pushState({ viewer: true }, "");
          ownsEntry = true;
        }
      } else {
        // The visitor went Back (or forward): the entry is no longer ours.
        ownsEntry = false;
        if (dialog.open) {
          close();
        } else if (isViewerEntry(history.state)) {
          // Forward onto the entry of a viewer that's closed: step off it, or
          // the next Back would do nothing visible.
          goingBack = true;
          history.back();
        }
      }
    });

    for (const button of document.querySelectorAll<HTMLButtonElement>(
      "[data-viewer-open]",
    )) {
      button.addEventListener("click", () => {
        open(button);
      });
    }

    dialog.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) {
        return;
      }
      if (event.target.closest("[data-viewer-close]")) {
        close();
      } else if (event.target.closest("[data-viewer-previous]")) {
        move(-1);
      } else if (event.target.closest("[data-viewer-next]")) {
        move(1);
      }
    });

    // Light dismiss where `closedby` isn't supported: a press and release
    // outside the card. On phones the viewer fills the screen, so there's no
    // outside.
    if (!("closedBy" in HTMLDialogElement.prototype)) {
      const outside = (event: PointerEvent) => {
        const box = dialog.getBoundingClientRect();
        return (
          event.clientX < box.left ||
          event.clientX > box.right ||
          event.clientY < box.top ||
          event.clientY > box.bottom
        );
      };
      let pressedOutside = false;
      dialog.addEventListener("pointerdown", (event) => {
        pressedOutside = outside(event);
      });
      dialog.addEventListener("pointerup", (event) => {
        if (pressedOutside && outside(event)) {
          close();
        }
      });
    }

    // Esc and a click outside shrink it too.
    dialog.addEventListener("cancel", shrink);
    fadeOnCloseRequests(dialog);

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
        event.preventDefault();
        move(event.key === "ArrowLeft" ? -1 : 1);
      }
    });

    // One finger: swipe sideways to move, drag down to close. On phones the
    // photos and the viewer follow the finger. The direction locks after a
    // few pixels, so a sideways swipe never moves the viewer down.
    let gesture: { x: number; y: number; lock?: "x" | "y" } | undefined;

    const cancelGesture = () => {
      gesture = undefined;
      endDrag();
      endSwipe();
    };

    dialog.addEventListener(
      "touchstart",
      (event) => {
        const touch = event.touches[0];
        if (event.touches.length === 1 && touch !== undefined && !zoomedIn()) {
          gesture = { x: touch.clientX, y: touch.clientY };
        } else {
          cancelGesture();
        }
      },
      { passive: true },
    );

    dialog.addEventListener(
      "touchmove",
      (event) => {
        const touch = event.touches[0];
        if (gesture === undefined || touch === undefined) {
          return;
        }
        if (event.touches.length > 1 || zoomedIn()) {
          cancelGesture();
          return;
        }
        const x = touch.clientX - gesture.x;
        const y = touch.clientY - gesture.y;
        if (
          gesture.lock === undefined &&
          Math.max(Math.abs(x), Math.abs(y)) > lockAfter
        ) {
          gesture.lock = Math.abs(y) > Math.abs(x) ? "y" : "x";
        }
        if (gesture.lock === "y" && phone.matches) {
          dialog.dataset.dragging = "";
          setDrag(Math.max(0, y));
        } else if (gesture.lock === "x" && slides() && photos.length > 1) {
          setSwipe(x);
        }
      },
      { passive: true },
    );

    dialog.addEventListener("touchend", (event) => {
      const touch = event.changedTouches[0];
      const start = gesture;
      gesture = undefined;
      if (start === undefined || touch === undefined) {
        return;
      }
      const x = touch.clientX - start.x;
      const y = touch.clientY - start.y;
      if (start.lock === "y" && y > dragToClose) {
        // Only a phone's viewer follows the finger down.
        close({ dragged: phone.matches });
        return;
      }
      // Settles on the next photo, or springs back.
      endDrag();
      endSwipe();
      if (start.lock === "x" && Math.abs(x) > swipeToMove && !atEnd(x)) {
        move(x < 0 ? 1 : -1);
      }
    });

    dialog.addEventListener("touchcancel", cancelGesture);
  }
</script>

<style>
  /* A share of the window, between a floor (where it fits) and a cap, and
     never so tall that the caption and the key hints leave the screen. The
     same size for every photo. */
  .viewer {
    inline-size: min(
      var(--viewer-w),
      max(
        var(--viewer-share),
        min(100% - 2 * var(--space-6), var(--viewer-min))
      ),
      (100dvh - var(--viewer-chrome)) * 3 / 2
    );
    max-inline-size: none;
    max-block-size: calc(100% - 2 * var(--space-6));
    padding: 0;
    overflow: hidden;
    border: var(--hairline) solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg);
    color: var(--text);
    box-shadow: var(--shadow-overlay);
    /* Not only while open: a closing viewer keeps its layout while it fades
       out. */
    flex-direction: column;

    &[open] {
      display: flex;
    }

    &::backdrop {
      background: var(--scrim);
      backdrop-filter: var(--scrim-backdrop);
    }
  }

  /* It grows out of the photo that opened it (the script), so it only fades
     in here. */
  @media (prefers-reduced-motion: no-preference) {
    .viewer[open] {
      transition: opacity var(--dur-slow) var(--ease);
    }
  }

  /* The page behind a modal viewer doesn't scroll. */
  :global(html:has(.viewer[open])) {
    overflow: hidden;
  }

  .figure {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-block-size: 0;
    margin: 0;
  }

  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    min-block-size: 0;
  }

  /* Content box, so the bottom hairline doesn't take a pixel from the 3:2
     photo, which would leave the photo narrower than the frame. */
  .frame {
    box-sizing: content-box;
    min-block-size: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-block-end: var(--hairline) solid var(--line);
    background: var(--surface);
  }

  /* The photos are stacked and crossfade; on phones they slide (below).
     Each one fills the 3:2 frame, cropped if it's another shape. */
  .track {
    display: grid;
    block-size: 100%;

    :global(.slide) {
      grid-area: 1 / 1;
      min-inline-size: 0;
      min-block-size: 0;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--dur) var(--ease);
    }

    :global(.slide.current) {
      opacity: 1;
      pointer-events: auto;
    }

    :global(.image) {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
    }
  }

  .caption {
    display: flex;
    flex: none;
    flex-direction: column;
    padding: var(--space-4) var(--space-5);
  }

  .title {
    font-weight: var(--weight-medium);
    line-height: var(--leading-tight);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-2);
    color: var(--text-3);
    font-size: var(--text-small);
  }

  .position {
    font-variant-numeric: tabular-nums;
  }

  /* Above the controls' own display. */
  .viewer [hidden] {
    display: none;
  }

  .control {
    position: absolute;
    z-index: var(--z-viewer-controls);
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--viewer-button);
    block-size: var(--viewer-button);
    padding: 0;
    border: var(--hairline) solid var(--line);
    border-radius: var(--r-full);
    background: var(--photo-control-bg);
