---
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { photoImage, viewerImage } from "../lib/attachment.ts";
import { getViewerCopy } from "../lib/content.ts";
import { fill } from "../lib/template.ts";

// An entry's photos. Each one is a button that opens the image viewer
// (ImageViewer.astro), which reads the entry's caption and a larger copy of
// the same file from here.
type Props = {
  title: string;
  subtitle?: string | undefined;
  // As the entry's date column shows it.
  date: string;
  photos: readonly { src: ImageMetadata; alt: string }[];
};

const { title, subtitle, date, photos: sources } = Astro.props;
const copy = await getViewerCopy();
const count = sources.length;
const photos = await Promise.all(
  sources.map(async ({ src, alt }, index) => {
    const large = await getImage({
      src,
      widths: [...viewerImage.widths],
      sizes: viewerImage.sizes,
    });
    const label = fill(count === 1 ? copy.openOne : copy.open, {
      index: String(index + 1),
      count: String(count),
      title,
    });
    return { src, alt, large, label };
  }),
);
---

<ul
  class="photos"
  role="list"
  data-viewer-entry={title}
  data-viewer-subtitle={subtitle}
  data-viewer-date={date}
>
  {photos.map(({ src, alt, large, label }) => (
    <li>
      <button
        class="open"
        type="button"
        aria-label={label}
        data-viewer-open
        data-viewer-src={large.src}
        data-viewer-srcset={large.srcSet.attribute}
      >
        <Image
          class="photo"
          src={src}
          alt={alt}
          widths={[...photoImage.widths]}
          sizes={photoImage.sizes}
          loading="lazy"
        />
      </button>
    </li>
  ))}
</ul>

<script>
  // Tabbing to a photo that only peeks into the strip leaves it there, so
  // slide the strip to the focused photo. Only for keyboard focus: a mouse
  // press focuses the photo before the click lands, and sliding then would
  // move it out from under the pointer. Only the strip: scrolling the page
  // too would jump it whenever a photo sits under the sticky header.
  for (const photos of document.querySelectorAll("[data-viewer-entry]")) {
    photos.addEventListener("focusin", (event) => {
      if (
        event.target instanceof HTMLElement &&
        event.target.matches(":focus-visible")
      ) {
        photos.scrollBy({
          left:
            event.target.getBoundingClientRect().left -
            photos.getBoundingClientRect().left,
        });
      }
    });
  }
</script>

<style>
  /* Always three slots, so one or two photos keep the same size. */
  .photos {
    --photo-hover: 0.88;
    /* Room left for the next photo in the strip: the 8px gap plus a 32px peek. */
    --photo-peek: 40px;

    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }

  /* Rows too narrow for the date column (an entry wraps at 436px: the date
     column, its gap and the text's basis) show the photos full width. Several
     scroll sideways, the next one peeking in. */
  @container attachment (width < 436px) {
    .photos {
      display: flex;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;

      li {
        flex: 0 0 calc(100% - var(--photo-peek));
        scroll-snap-align: start;

        &:only-child {
          flex-basis: 100%;
        }
      }
    }

    /* Inside the photo, or the strip would clip it. On the image, because
       the image would cover the button's. */
    .open:focus-visible {
      outline: none;

      .photo {
        outline: var(--focus-ring) solid var(--accent);
        outline-offset: calc(-1 * var(--focus-ring));
      }
    }
  }

  .open {
    display: block;
    inline-size: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--r-md);
    background: none;
    cursor: zoom-in;
  }

  .photo {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 2;
    /* A long press opens the viewer's photo, not the browser's image menu. */
    -webkit-touch-callout: none;
    border: var(--hairline) solid var(--line);
    border-radius: var(--r-md);
    background: var(--surface);
    object-fit: cover;

    @media (hover: hover) and (pointer: fine) {
      transition: opacity var(--dur-quick) var(--ease);

      .open:hover & {
        opacity: var(--photo-hover);
      }
    }
  }
</style>
