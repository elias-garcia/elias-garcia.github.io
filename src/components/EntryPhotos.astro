---
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { photoImage, viewerImage } from "../lib/attachment.ts";
import { getViewerCopy } from "../lib/content.ts";
import { fill } from "../lib/template.ts";

// An entry's photos. Each one is a button that opens the image viewer
// (ImageViewer.astro), which reads the entry's caption and a larger copy of
// the same file from here.
type Props = {
  title: string;
  subtitle?: string | undefined;
  // As the entry's date column shows it.
  date: string;
  photos: readonly { src: ImageMetadata; alt: string }[];
};

const { title, subtitle, date, photos: sources } = Astro.props;
const copy = await getViewerCopy();
const count = sources.length;
const photos = await Promise.all(
  sources.map(async ({ src, alt }, index) => {
    const large = await getImage({
      src,
      widths: [...viewerImage.widths],
      sizes: viewerImage.sizes,
    });
    const label = fill(count === 1 ? copy.openOne : copy.open, {
      index: String(index + 1),
      count: String(count),
      title,
    });
    return { src, alt, large, label };
  }),
);
---

<div class="strip">
  <ul
    class="photos"
    role="list"
    data-viewer-entry={title}
    data-viewer-subtitle={subtitle}
    data-viewer-date={date}
  >
    {photos.map(({ src, alt, large, label }) => (
      <li>
        <button
          class="open"
          type="button"
          aria-label={label}
          data-viewer-open
          data-viewer-src={large.src}
          data-viewer-srcset={large.srcSet.attribute}
        >
          <Image
            class="photo"
            src={src}
            alt={alt}
            widths={[...photoImage.widths]}
            sizes={photoImage.sizes}
            loading="lazy"
          />
        </button>
      </li>
    ))}
  </ul>
  {/* On narrow rows, where the photos scroll one at a time: how far along
  the strip is. Decoration; each photo's name says which of how many it is. */}
  {count > 1 && (
    <div class="scroll-line" style={`--photos: ${count}`} aria-hidden="true">
      <span class="marker"></span>
    </div>
  )}
</div>

<script>
  // Tabbing to a photo outside the strip's view leaves it there, so slide
  // the strip to the focused photo. Only for keyboard focus: a mouse
  // press focuses the photo before the click lands, and sliding then would
  // move it out from under the pointer. Only the strip: scrolling the page
  // too would jump it whenever a photo sits under the sticky header.
  for (const photos of document.querySelectorAll("[data-viewer-entry]")) {
    photos.addEventListener("focusin", (event) => {
      if (
        event.target instanceof HTMLElement &&
        event.target.matches(":focus-visible")
      ) {
        photos.scrollBy({
          left:
            event.target.getBoundingClientRect().left -
            photos.getBoundingClientRect().left,
        });
      }
    });
  }
</script>

<style>
  /* Always three slots, so one or two photos keep the same size. */
  .photos {
    --photo-hover: 0.88;

    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .scroll-line {
    display: none;
  }

  /* Rows too narrow for the date column (an entry wraps at 436px: the date
     column, its gap and the text's basis) show the photos full width, every
     one as wide as a single photo. Several scroll sideways, one at a time. */
  @container entry (width < 436px) {
    .photos {
      display: flex;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;

      & > li {
        flex: 0 0 100%;
        scroll-snap-align: start;
      }
    }

    /* A line under the strip, with a marker one photo's share of it that the
       strip's scrolling moves from end to end. Only where the browser can tie
       it to the scrolling: a marker that doesn't move would mislead. It stays
       with reduced motion: like a scrollbar, it only follows the finger. */
    @supports (animation-timeline: scroll()) {
      .strip {
        timeline-scope: --photo-strip;
      }

      .photos {
        scroll-timeline: --photo-strip x;
      }

      .scroll-line {
        display: block;
        block-size: var(--rule-strong);
        margin-block-start: var(--space-3);
        overflow: hidden;
        border-radius: calc(var(--rule-strong) / 2);
        background: var(--line);
      }

      .marker {
        display: block;
        inline-size: calc(100% / var(--photos));
        block-size: 100%;
        border-radius: inherit;
        background: var(--text-3);
        /* Longhands: the build's CSS minifier folds animation-timeline into
           the animation shorthand, which browsers then reject. */
        animation-name: scroll-line;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --photo-strip;
      }
    }

    /* Inside the photo, or the strip would clip it. On the image, because
       the image would cover the button's. */
    .open:focus-visible {
      outline: none;

      & > .photo {
        outline: var(--focus-ring) solid var(--accent);
        outline-offset: calc(-1 * var(--focus-ring));
      }
    }
  }

  .open {
    display: block;
    inline-size: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--r-md);
    background: none;
    cursor: zoom-in;
  }

  .photo {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    /* A long press opens the viewer's photo, not the browser's image menu. */
    -webkit-touch-callout: none;
    border: var(--hairline) solid var(--line);
    border-radius: var(--r-md);
    background: var(--surface);
    object-fit: cover;

    @media (hover: hover) and (pointer: fine) {
      transition: opacity var(--dur-quick) var(--ease);

      .open:hover & {
        opacity: var(--photo-hover);
      }
    }
  }

  @keyframes scroll-line {
    to {
      translate: calc((var(--photos) - 1) * 100%) 0;
    }
  }

  @media (forced-colors: active) {
    .marker {
      background: CanvasText;
    }
  }
</style>
