---
import Button from "./Button.astro";
import VisuallyHidden from "./VisuallyHidden.astro";

type Props = {
  label: string;
  name: string;
  onSurface?: boolean;
  // Copies this URL's text; without it, the text of the [data-copy-text]
  // element inside the closest [data-copy-scope].
  url?: string;
};

const { label, name, url, onSurface = false } = Astro.props;
---

<span class="copy">
  <Button
    aria-label={name}
    onSurface={onSurface}
    data-copy-button
    data-copy-url={url}
  >
    <slot />
    <span data-copy-label={label}>{label}</span>
  </Button>
  <VisuallyHidden>
    <span role="status" data-copy-status></span>
  </VisuallyHidden>
</span>

<script>
  const copiedFor = 1500;
  const timers = new WeakMap<HTMLElement, number>();

  async function textToCopy(button: HTMLElement): Promise<string> {
    const { copyUrl } = button.dataset;
    if (copyUrl !== undefined) {
      const response = await fetch(copyUrl);
      if (!response.ok) {
        throw new Error(`Could not load ${copyUrl}.`);
      }
      return response.text();
    }
    const source = button
      .closest("[data-copy-scope]")
      ?.querySelector<HTMLElement>("[data-copy-text]");
    return source?.innerText ?? "";
  }

  function showCopied(button: HTMLElement): void {
    const message = "Copied";
    const label = button.querySelector<HTMLElement>("[data-copy-label]");
    const status = button.parentElement?.querySelector("[data-copy-status]");
    if (label === null || status === null || status === undefined) {
      return;
    }
    label.textContent = message;
    status.textContent = message;
    window.clearTimeout(timers.get(button));
    timers.set(
      button,
      window.setTimeout(() => {
        label.textContent = label.dataset["copyLabel"] ?? "";
        status.textContent = "";
      }, copiedFor),
    );
  }

  async function copy(button: HTMLElement): Promise<void> {
    try {
      // A promise inside ClipboardItem keeps the click's permission while the
      // text loads, which Safari needs for the fetched Markdown.
      await navigator.clipboard.write([
        new ClipboardItem({ "text/plain": textToCopy(button) }),
      ]);
      showCopied(button);
    } catch {
      // The design only has "Copied": a failed copy leaves the button as it was.
    }
  }

  for (const button of document.querySelectorAll<HTMLElement>(
    "[data-copy-button]",
  )) {
    button.addEventListener("click", () => {
      void copy(button);
    });
  }
</script>

<style>
  .copy {
    display: inline-flex;

    /* Copying needs the script. */
    @media (scripting: none) {
      display: none;
    }
  }
</style>
