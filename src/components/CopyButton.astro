---
import { getPostCopy } from "../lib/content.ts";
import Button from "./Button.astro";
import VisuallyHidden from "./VisuallyHidden.astro";

type Props = {
  label: string;
  name: string;
  onSurface?: boolean;
  // Copies this URL's text; without it, the text of the [data-copy-text]
  // element inside the closest [data-copy-scope].
  url?: string;
};

const { label, name, url, onSurface = false } = Astro.props;
const { copied } = await getPostCopy();
---

<span class="copy">
  <Button
    aria-label={name}
    onSurface={onSurface}
    data-copy-button
    data-copy-url={url}
  >
    <slot />
    <span class="labels">
      <span data-copy-label>{label}</span>
      <span aria-hidden="true" data-copy-done>
        {copied}
      </span>
    </span>
  </Button>
  <VisuallyHidden>
    <span role="status" data-copy-status></span>
  </VisuallyHidden>
</span>

<script>
  const copiedFor = 1500;
  const timers = new WeakMap<HTMLElement, number>();

  async function textToCopy(button: HTMLElement): Promise<string> {
    const { copyUrl } = button.dataset;
    if (copyUrl !== undefined) {
      const response = await fetch(copyUrl);
      if (!response.ok) {
        throw new Error(`Could not load ${copyUrl}.`);
      }
      return response.text();
    }
    const source = button
      .closest("[data-copy-scope]")
      ?.querySelector<HTMLElement>("[data-copy-text]");
    return source?.innerText ?? "";
  }

  // Both labels are always there, so the button keeps the longer one's
  // width; only the one showing is exposed.
  function setCopied(button: HTMLElement, copied: boolean): void {
    button.toggleAttribute("data-copied", copied);
    button
      .querySelector("[data-copy-label]")
      ?.setAttribute("aria-hidden", String(copied));
    button
      .querySelector("[data-copy-done]")
      ?.setAttribute("aria-hidden", String(!copied));
  }

  function showCopied(button: HTMLElement): void {
    const status = button.parentElement?.querySelector("[data-copy-status]");
    if (status === null || status === undefined) {
      return;
    }
    setCopied(button, true);
    status.textContent =
      button.querySelector("[data-copy-done]")?.textContent ?? "";
    window.clearTimeout(timers.get(button));
    timers.set(
      button,
      window.setTimeout(() => {
        setCopied(button, false);
        status.textContent = "";
      }, copiedFor),
    );
  }

  async function copy(button: HTMLElement): Promise<void> {
    try {
      // A promise inside ClipboardItem keeps the click's permission while the
      // text loads, which Safari needs for the fetched Markdown.
      await navigator.clipboard.write([
        new ClipboardItem({ "text/plain": textToCopy(button) }),
      ]);
      showCopied(button);
    } catch {
      // The design only has "Copied": a failed copy leaves the button as it was.
    }
  }

  for (const button of document.querySelectorAll<HTMLElement>(
    "[data-copy-button]",
  )) {
    button.addEventListener("click", () => {
      void copy(button);
    });
  }
</script>

<style>
  .copy {
    display: inline-flex;

    /* Copying needs the script. */
    @media (scripting: none) {
      display: none;
    }
  }

  /* One cell for both labels, so the button never changes width. They swap
     with a short crossfade, as transitions so a second click mid-swap
     reverses smoothly; with reduced motion only the opacity changes. */
  .labels {
    display: inline-grid;
    justify-items: center;

    > * {
      grid-area: 1 / 1;
      transition: opacity var(--dur) var(--ease-settle);
    }
  }

  .labels > :last-child,
  :global([data-copied]) .labels > :first-child {
    opacity: 0;
  }

  :global([data-copied]) .labels > :last-child {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .labels > * {
      transition:
        opacity var(--dur) var(--ease-settle),
        filter var(--dur) var(--ease-settle),
        scale var(--dur) var(--ease-settle);
    }

    .labels > :last-child,
    :global([data-copied]) .labels > :first-child {
      filter: blur(var(--swap-blur));
      scale: var(--swap-scale);
    }

    :global([data-copied]) .labels > :last-child {
      filter: none;
      scale: 1;
    }
  }
</style>
