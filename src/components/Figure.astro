---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

// An imported image, (in MDX) a Markdown image passed as the content:
// <Figure caption="…">![alt](path)</Figure>, or a placeholder for an image
// still to come.
type Props = { caption: string } & (
  | {
      src: ImageMetadata;
      alt: string;
      aspectRatio?: string;
      objectPosition?: string;
      placeholder?: never;
    }
  | { placeholder: string }
  | { src?: never; placeholder?: never }
);

const { caption } = Astro.props;
---

<figure class="figure">
  {Astro.props.placeholder !== undefined ? (
    <div class="placeholder">{Astro.props.placeholder}</div>
  ) : Astro.props.src === undefined ? (
    <div class="markdown">
      <slot />
    </div>
  ) : (
    <Image
      class="image"
      src={Astro.props.src}
      alt={Astro.props.alt}
      widths={[640, 1280]}
      sizes="(width <= 688px) 100vw, 640px"
      style={{
        aspectRatio: Astro.props.aspectRatio,
        objectPosition: Astro.props.objectPosition,
      }}
    />
  )}
  <figcaption class="caption">{caption}</figcaption>
</figure>

<style>
  .figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .image,
  .markdown :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--r-lg);
    background: var(--control);
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    padding: var(--space-6);
    border: var(--hairline) dashed var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--surface);
    color: var(--text-3);
    font-size: var(--text-small);
    text-align: center;
  }

  .caption {
    color: var(--text-3);
    font-size: var(--text-meta);
  }
</style>
