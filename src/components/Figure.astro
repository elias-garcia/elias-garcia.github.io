---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

type Props = {
  src: ImageMetadata;
  alt: string;
  caption: string;
  aspectRatio?: string;
  objectPosition?: string;
};

const { src, alt, caption, aspectRatio, objectPosition } = Astro.props;
---

<figure class="figure">
  <Image
    class="image"
    src={src}
    alt={alt}
    widths={[640, 1280]}
    sizes="(width <= 688px) 100vw, 640px"
    style={{ aspectRatio, objectPosition }}
  />
  <figcaption class="caption">{caption}</figcaption>
</figure>

<style>
  .figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .image {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--r-lg);
    background: var(--control);
    object-fit: cover;
  }

  .caption {
    color: var(--text-3);
    font-size: var(--text-meta);
  }
</style>
