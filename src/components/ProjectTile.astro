---
import type { CollectionEntry } from "astro:content";
import { hasCaseStudy } from "../lib/content.ts";
import ProjectPreview from "./ProjectPreview.astro";
import ProjectStatus from "./ProjectStatus.astro";

type Props = {
  project: CollectionEntry<"projects">;
};

const { project } = Astro.props;
const href = hasCaseStudy(project) ? `/projects/${project.id}` : undefined;
const Tag = href === undefined ? "div" : "a";
---

<li class="cell">
  <Tag class="tile" href={href}>
    <ProjectPreview illustration={project.data.illustration} />
    <div class="head">
      <h3 class="title">{project.data.title}</h3>
      <ProjectStatus status={project.data.status} year={project.data.year} />
    </div>
    <p class="summary">{project.data.summary}</p>
  </Tag>
</li>

<style>
  .cell,
  .tile {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    align-content: start;
  }

  /* The tile sets its own row gap, so the page's grid gap only spaces
     tiles apart. */
  .tile {
    row-gap: var(--space-2);

    :global(.preview) {
      margin-block-end: var(--space-2);
    }

    @media (width < 40rem) {
      padding-block-end: var(--space-5);
    }
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .title {
    font-size: inherit;
    font-weight: var(--weight-medium);
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  .summary {
    color: var(--text-2);
    font-size: var(--text-small);
  }

  .tile:focus-visible {
    border-radius: var(--r-lg);
  }
</style>
