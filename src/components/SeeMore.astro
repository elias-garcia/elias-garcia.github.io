---
type Props = {
  href: string;
  label: string;
};

const { href, label } = Astro.props;
---

<a class="more" href={href}>
  <span class="label">{label}</span>
  <svg viewBox="0 0 16 16" aria-hidden="true">
    <path d="M6 3.5L10.5 8 6 12.5"></path>
  </svg>
</a>

<style>
  .more {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--text-2);
    font-size: var(--text-small);
    transition: color var(--dur) var(--ease);

    @media (hover: hover) and (pointer: fine) {
      &:hover {
        color: var(--text);
      }
    }

    &:focus-visible {
      border-radius: var(--r-sm);
    }
  }

  .label {
    position: relative;

    &::after {
      content: "";
      position: absolute;
      inset-inline: 0;
      inset-block-end: calc(-1 * var(--hairline));
      block-size: var(--hairline);
      background: currentColor;
      opacity: 0;
    }
  }

  svg {
    inline-size: var(--icon-sm);
    block-size: var(--icon-sm);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) and (pointer: fine) {
    .label::after {
      transition: opacity var(--dur) var(--ease-settle);
    }

    .more:hover .label::after {
      opacity: 1;
    }

    .more:hover svg {
      translate: var(--nudge) 0;
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    svg {
      transition: translate var(--dur) var(--ease-settle);
    }
  }
</style>
