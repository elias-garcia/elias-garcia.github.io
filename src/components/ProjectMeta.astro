---
import type { CollectionEntry } from "astro:content";
import MetaItem from "./MetaItem.astro";
import MetaLine from "./MetaLine.astro";

// A project's type and year, under its title on a tile or card. Its status
// shows only on its page, in the facts (DESIGN.md, Project facts).
type Props = Pick<CollectionEntry<"projects">["data"], "type" | "year">;

const { type, year } = Astro.props;
---

<p class="meta">
  <MetaLine>
    <MetaItem>{type}</MetaItem>
    <MetaItem>
      <time datetime={String(year)}>{year}</time>
    </MetaItem>
  </MetaLine>
</p>

<style>
  .meta {
    color: var(--text-3);
    font-size: var(--text-small);
  }
</style>
