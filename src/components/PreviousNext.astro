---
import Icon from "./Icon.astro";

type Link = {
  href: string;
  title: string;
  label: string;
};

type Props = {
  name: string;
  previous: Link | undefined;
  next: Link | undefined;
};

const { name, previous, next } = Astro.props;
const links = [
  previous && { ...previous, direction: "previous" },
  next && { ...next, direction: "next" },
].filter((link) => link !== undefined);
---

{links.length > 0 && (
  <nav class="previous-next" aria-label={name}>
    {links.map(({ href, title, label, direction }) => (
      <a class:list={["card", direction]} href={href}>
        <span class="label">
          {direction === "previous" && (
            <Icon name="chevron-left" class="chevron" />
          )}
          {label}
          {direction === "next" && (
            <Icon name="chevron-right" class="chevron" />
          )}
        </span>
        <span class="title">{title}</span>
      </a>
    ))}
  </nav>
)}

<style>
  /* A column that can't grow past the page, so a word that can't break
     (an identifier in a title) breaks at the end of the line instead. */
  .previous-next {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);

    /* Side by side from 640px; a card on its own takes the full width. */
    @media (width >= 40rem) {
      grid-template-columns: none;
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: var(--hairline) solid var(--line);
    border-radius: var(--r-lg);
    transition:
      border-color var(--dur-quick) var(--ease),
      background var(--dur-quick) var(--ease);

    @media (hover: hover) and (pointer: fine) {
      &:hover {
        border-color: var(--line-strong);
        background: var(--surface);
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      transition:
        border-color var(--dur-quick) var(--ease),
        background var(--dur-quick) var(--ease),
        scale var(--dur-quick) var(--ease-settle);

      &:active {
        scale: var(--press-scale-tile);
      }
    }
  }

  /* The chevron sits on the side the card leads to. */
  .next {
    align-items: end;
    text-align: end;
  }

  .label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-3);
    font-size: var(--text-small);
  }

  .title {
    font-weight: var(--weight-medium);
  }

  @media (hover: hover) and (pointer: fine) {
    .previous:hover .chevron {
      translate: calc(-1 * var(--nudge)) 0;
    }

    .next:hover .chevron {
      translate: var(--nudge) 0;
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .chevron {
      transition: translate var(--dur-quick) var(--ease-settle);
    }
  }
</style>
