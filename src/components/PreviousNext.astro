---
type Link = {
  href: string;
  title: string;
  label: string;
};

type Props = {
  name: string;
  previous: Link | undefined;
  next: Link | undefined;
};

const { name, previous, next } = Astro.props;
const links = [
  previous && { ...previous, direction: "previous" },
  next && { ...next, direction: "next" },
].filter((link) => link !== undefined);
---

{links.length > 0 && (
  <nav class="previous-next" aria-label={name}>
    {links.map(({ href, title, label, direction }) => (
      <a class:list={["card", direction]} href={href}>
        <span class="label">
          {direction === "previous" && (
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M10 3.5L5.5 8l4.5 4.5" />
            </svg>
          )}
          {label}
          {direction === "next" && (
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M6 3.5L10.5 8 6 12.5" />
            </svg>
          )}
        </span>
        <span class="title">{title}</span>
      </a>
    ))}
  </nav>
)}

<style>
  .previous-next {
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(min(var(--row-basis), 100%), 1fr)
    );
    gap: var(--space-4);
    margin-block-start: var(--space-2);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: var(--hairline) solid var(--line);
    border-radius: var(--r-lg);
    transition:
      border-color var(--dur) var(--ease),
      background var(--dur) var(--ease);

    &:hover {
      border-color: var(--line-strong);
      background: var(--surface);
    }
  }

  /* The chevron sits on the side the card leads to. */
  .next {
    align-items: end;
    text-align: end;
  }

  .label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-3);
    font-size: var(--text-meta);
  }

  .title {
    font-weight: var(--weight-medium);
  }

  svg {
    inline-size: var(--icon-md);
    block-size: var(--icon-md);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) and (pointer: fine) {
    .previous:hover svg {
      translate: calc(-1 * var(--nudge)) 0;
    }

    .next:hover svg {
      translate: var(--nudge) 0;
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    svg {
      transition: translate var(--dur) var(--ease-settle);
    }
  }
</style>
