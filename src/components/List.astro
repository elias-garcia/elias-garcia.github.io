<ul class="list" role="list">
  <slot />
</ul>

<style>
  .list {
    display: flex;
    flex-direction: column;
  }

  /* Hovering one interactive row quiets the others, on real pointers only. */
  @media (hover: hover) and (pointer: fine) {
    .list:has(:global(.row-interactive:hover))
      :global(.row-interactive:not(:hover)) {
      opacity: 0.45;
    }
  }
</style>
