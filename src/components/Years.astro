---
import { getHomeCopy } from "../lib/content.ts";

type Props = {
  start: number;
  end?: number | undefined;
};

const { start, end } = Astro.props;
const { present } = await getHomeCopy();
---

<time datetime={String(start)}>{start}</time>
{" – "}
{end === undefined ? present : <time datetime={String(end)}>{end}</time>}
