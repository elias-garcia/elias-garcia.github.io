---
import { opensNewTab } from "../lib/links.ts";
import Icon from "./Icon.astro";
import NewTabNote from "./NewTabNote.astro";

type Props = {
  href: string;
};

const { href } = Astro.props;
---

<Icon name="external" size="sm" class="external" />
{opensNewTab(href) && <NewTabNote />}

<style>
  .external {
    /* The nudge on hover, and the offset from the baseline. */
    --nudge-sm: 1px;

    display: inline-block;
    margin-inline-start: var(--space-1);
    vertical-align: calc(-1 * var(--nudge-sm));
    stroke: var(--text-3);
    transition: stroke var(--dur) var(--ease);

    :global(a:focus-visible) & {
      stroke: currentColor;
    }

    @media (hover: hover) and (pointer: fine) {
      :global(a:hover) & {
        stroke: currentColor;
      }
    }

    @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
      transition:
        stroke var(--dur) var(--ease),
        translate var(--dur) var(--ease-settle);

      :global(a:hover) & {
        translate: var(--nudge-sm) calc(-1 * var(--nudge-sm));
      }
    }
  }
</style>
