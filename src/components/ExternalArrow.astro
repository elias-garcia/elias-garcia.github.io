---
import Icon from "./Icon.astro";

// The arrow after a link that leaves the site (DESIGN.md, External-link
// arrow). It takes the link's colour and nudges when the link is hovered.
---

<Icon name="arrow-up-right" size="sm" class="external" />

<style>
  .external {
    /* The nudge on hover, and the offset from the baseline. */
    --nudge-sm: 1px;

    display: inline-block;
    margin-inline-start: var(--space-1);
    vertical-align: calc(-1 * var(--nudge-sm));
    stroke: var(--text-3);
    transition: stroke var(--dur-quick) var(--ease);

    :global(a:focus-visible) & {
      stroke: currentColor;
    }

    @media (hover: hover) and (pointer: fine) {
      :global(a:hover) & {
        stroke: currentColor;
      }
    }

    @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
      transition:
        stroke var(--dur-quick) var(--ease),
        translate var(--dur-quick) var(--ease-settle);

      :global(a:hover) & {
        translate: var(--nudge-sm) calc(-1 * var(--nudge-sm));
      }
    }
  }
</style>
