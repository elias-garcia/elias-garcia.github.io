---
import { getCvFormats } from "../lib/cv.ts";
import Button from "./Button.astro";
import CvFormatIcon from "./CvFormatIcon.astro";

const formats = await getCvFormats();
---

<div class="download">
  <Button
    class="trigger"
    popovertarget="cv-formats"
    aria-controls="cv-formats"
    data-cv-button
  >
    Download CV
    <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M4.5 6.5L8 10l3.5-3.5"></path>
    </svg>
  </Button>
  <ul class="formats" id="cv-formats" popover role="list" data-cv-formats>
    {formats.map((format) => (
      <li>
        <a class="format" href={format.href} download>
          <span class="tile" aria-hidden="true">
            <CvFormatIcon format={format.icon} />
          </span>
          <span class="text">
            <span class="title">
              {format.label} <span class="size">{format.size}</span>
            </span>
            <span class="description">{format.description}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  import { closeTopLayer, isClosing, stopClosing } from "../lib/top-layer.ts";

  const menu = document.querySelector<HTMLElement>("[data-cv-formats]");
  const button = document.querySelector<HTMLElement>("[data-cv-button]");

  if (menu !== null && button !== null) {
    const close = () => {
      void closeTopLayer(menu, () => {
        menu.hidePopover();
      });
    };

    // The button closes the menu with its fade too, instead of the popover's
    // own toggle, which can't wait for it; pressed during the fade, it keeps
    // the menu open. A tap outside still closes it at once where CSS can't
    // fade it out (DESIGN.md §2.5).
    button.addEventListener("click", (event) => {
      if (!menu.matches(":popover-open")) {
        return;
      }
      event.preventDefault();
      if (isClosing(menu)) {
        stopClosing(menu);
      } else {
        close();
      }
    });

    // A download doesn't leave the page, so choosing a format closes the menu.
    menu.addEventListener("click", ({ target }) => {
      if (target instanceof Element && target.closest("a") !== null) {
        close();
      }
    });

    // Tabbing out of the menu closes it, as DESIGN.md asks.
    menu.addEventListener("focusout", ({ relatedTarget }) => {
      if (
        relatedTarget instanceof Node &&
        !menu.contains(relatedTarget) &&
        relatedTarget !== button
      ) {
        close();
      }
    });

    // The menu closes as soon as the page scrolls: in the top layer it would
    // drift from its button and cover the sticky header. While focus is in
    // the menu, scrolling doesn't close it, so tabbing through it (which
    // scrolls the focused link into view) keeps it open; a mouse wheel
    // always closes it.
    const closeOnScroll = () => {
      if (!menu.contains(document.activeElement)) {
        close();
      }
    };
    menu.addEventListener("toggle", (event) => {
      if (event.newState === "open") {
        addEventListener("scroll", closeOnScroll, { passive: true });
        addEventListener("wheel", close, { passive: true });
      } else {
        removeEventListener("scroll", closeOnScroll);
        removeEventListener("wheel", close);
      }
    });

    // Without CSS anchor positioning, place the menu under its button.
    if (!CSS.supports("anchor-name", "--cv-button")) {
      menu.addEventListener("beforetoggle", (event) => {
        if (event.newState !== "open") {
          return;
        }
        const { left, bottom } = button.getBoundingClientRect();
        menu.style.position = "absolute";
        menu.style.left = `${String(left + window.scrollX)}px`;
        menu.style.top = `${String(bottom + window.scrollY)}px`;
      });
    }
  }
</script>

<style>
  .chevron {
    margin-inline-end: calc(-1 * var(--space-1));

    :global(.button:has(+ .formats:popover-open:not([data-closing]))) & {
      rotate: 180deg;
    }

    @media (prefers-reduced-motion: no-preference) {
      transition: rotate var(--dur) var(--ease);
    }
  }

  .download :global(.trigger) {
    anchor-name: --cv-button;
  }

  .formats {
    position: fixed;
    position-anchor: --cv-button;
    inset: auto;
    margin: var(--space-2) 0 0;
    inline-size: var(--menu-w);
    max-inline-size: calc(100dvw - 2 * var(--space-6));
    padding: var(--space-1);
    border: var(--hairline) solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg);
    color: var(--text);
    box-shadow: var(--shadow-overlay);
    position-area: block-end span-inline-end;
    position-try-fallbacks: flip-inline;

    /* Column direction stays on while the menu animates closed. */
    flex-direction: column;
    transform-origin: top left;

    /* The overlay motion (DESIGN.md §2.5). Opening: a fade, and from the
       button it grows slightly; with reduced motion only the fade. */
    &:popover-open {
      display: flex;
      transition: opacity var(--dur-slow) var(--ease);

      @starting-style {
        opacity: 0;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      &:popover-open {
        transition:
          opacity var(--dur-slow) var(--ease),
          scale var(--dur-slow) var(--ease-settle);

        @starting-style {
          scale: var(--overlay-scale);
        }
      }
    }

    /* Closing: a quicker fade. Where a closing popover can stay in the top
       layer until it's done (`overlay`), CSS fades it out by itself... */
    @supports (overlay: auto) {
      transition-property: opacity, display, overlay;
      transition-duration: var(--dur);
      transition-timing-function: var(--ease);
      transition-behavior: allow-discrete;

      &:not(:popover-open) {
        opacity: 0;
      }
    }

    /* ...elsewhere, src/lib/top-layer.ts fades it out while it's still open,
       then closes it. */
    &:popover-open[data-closing] {
      opacity: 0;
      transition: opacity var(--dur) var(--ease);
    }
  }

  .format {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--r-md);
    transition: background var(--dur-fast) var(--ease);

    &:hover,
    &:focus-visible {
      background: var(--tint);
      outline-offset: 0;
    }
  }

  .tile {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: var(--control-h);
    block-size: var(--control-h);
    border-radius: var(--r-md);
    background: var(--control);
    color: var(--text-2);
    transition:
      background var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);

    .format:hover &,
    .format:focus-visible & {
      background: var(--bg);
      color: var(--accent);
    }

    :global(svg) {
      inline-size: var(--icon-md);
      block-size: var(--icon-md);
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
  }

  .text {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
    line-height: var(--leading-tight);
  }

  .title {
    font-size: var(--text-small);
  }

  .size {
    margin-inline-start: var(--space-1);
    color: var(--text-3);
    font-size: var(--text-micro);
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-fast) var(--ease);

    /* --text-3 is too faint on the tint background (DESIGN.md §2.1). */
    .format:is(:hover, :focus-visible) & {
      color: var(--text-2);
    }
  }

  .description {
    color: var(--text-2);
    font-size: var(--text-micro);
  }
</style>
