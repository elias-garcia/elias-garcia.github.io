---
import { getLayoutCopy } from "../lib/content.ts";
import Logo from "./Logo.astro";

type Props = {
  arrivalStep: number;
  name: string;
  country: string;
  timezone: string;
};

const { arrivalStep, name, country, timezone } = Astro.props;
const copy = await getLayoutCopy();
// The clock's sentence in pieces: the country always shows; the time and the
// words around it only once the script has filled the time in.
const clock = copy.clock.split(/(\{time\}|\{country\})/).filter(Boolean);
---

<footer class="footer enter" id="footer" style={`--i: ${String(arrivalStep)}`}>
  <div class="bar">
    <p class="owner">
      <Logo size="sm" />
      <span>
        {name}
        <span data-footer-enhanced hidden>
          , <span data-footer-year></span>
        </span>
      </span>
    </p>
    <p
      class="clock"
      data-footer-timezone={timezone}
      data-footer-same={copy.sameTime}
      data-footer-ahead={copy.ahead}
      data-footer-behind={copy.behind}
    >
      <span>
        {clock.map((part) =>
          part === "{country}" ? (
            country
          ) : (
            <span data-footer-enhanced hidden>
              {part === "{time}" ? <time data-footer-time /> : part}
            </span>
          ),
        )}
      </span>
      <span class="dot" data-footer-enhanced hidden aria-hidden="true">
        ·
      </span>
      <span
        class="offset"
        data-footer-enhanced
        hidden
        data-footer-offset
      ></span>
    </p>
  </div>
</footer>

<script>
  import { fill } from "../lib/template.ts";

  const clock = document.querySelector<HTMLElement>("[data-footer-timezone]");
  const timeZone = clock?.dataset.footerTimezone;
  const year = document.querySelector("[data-footer-year]");
  const time = document.querySelector("time[data-footer-time]");
  const offset = document.querySelector("[data-footer-offset]");

  function utcOffsetMinutes(date: Date, zone: string): number {
    const name = new Intl.DateTimeFormat("en", {
      timeZone: zone,
      timeZoneName: "longOffset",
    })
      .formatToParts(date)
      .find((part) => part.type === "timeZoneName")?.value;
    const [, sign = "+", hours = "0", minutes = "0"] =
      /GMT([+-])(\d{2}):(\d{2})/.exec(name ?? "") ?? [];
    return (sign === "-" ? -1 : 1) * (Number(hours) * 60 + Number(minutes));
  }

  // "5h", "1h 30m": through Intl where durations exist there.
  function formatOffset(hours: number, minutes: number): string {
    if ("DurationFormat" in Intl) {
      return new Intl.DurationFormat(document.documentElement.lang, {
        style: "narrow",
      }).format({ hours, minutes });
    }
    return [
      hours > 0 && `${String(hours)}h`,
      minutes > 0 && `${String(minutes)}m`,
    ]
      .filter(Boolean)
      .join(" ");
  }

  function describe(minutes: number): string {
    if (minutes === 0) {
      return clock?.dataset.footerSame ?? "";
    }
    const amount = formatOffset(
      Math.floor(Math.abs(minutes) / 60),
      Math.abs(minutes) % 60,
    );
    const template =
      (minutes > 0
        ? clock?.dataset.footerAhead
        : clock?.dataset.footerBehind) ?? "";
    return fill(template, { amount });
  }

  function update(zone: string): void {
    const now = new Date();
    const portugal = new Intl.DateTimeFormat("en-GB", {
      timeZone: zone,
      hour: "2-digit",
      minute: "2-digit",
    }).format(now);
    if (time instanceof HTMLTimeElement) {
      time.dateTime = portugal;
      time.textContent = portugal;
    }
    if (offset !== null) {
      offset.textContent = describe(
        utcOffsetMinutes(now, zone) + now.getTimezoneOffset(),
      );
    }
  }

  if (year !== null) {
    year.textContent = String(new Date().getFullYear());
  }
  if (timeZone !== undefined) {
    update(timeZone);
    setInterval(update, 30_000, timeZone);
  }
  for (const element of document.querySelectorAll("[data-footer-enhanced]")) {
    element.removeAttribute("hidden");
  }
</script>

<style>
  .footer {
    flex-shrink: 0;
    margin-block-start: var(--space-footer);
    padding-block-end: env(safe-area-inset-bottom, 0px);
    border-block-start: var(--hairline) solid var(--line);
    color: var(--text-3);
    font-size: var(--text-small);
    animation: page-in var(--dur-move) var(--ease-settle) backwards;

    @media (prefers-reduced-motion: reduce) {
      animation: page-fade var(--dur-quick) var(--ease-settle) backwards;
    }

    :global(:root[data-in-place]) & {
      animation: none;
    }
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    max-inline-size: var(--column);
    min-block-size: var(--bar-h);
    margin-inline: auto;
    padding: var(--space-3) var(--page-end) var(--space-3) var(--page-start);
  }

  .owner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .clock {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-variant-numeric: tabular-nums;

    @media (width < 40rem) {
      .dot,
      .offset {
        display: none;
      }
    }
  }
</style>
