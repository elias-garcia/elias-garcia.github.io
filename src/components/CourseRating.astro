---
import type { CollectionEntry } from "astro:content";
import { getHomeCopy } from "../lib/content.ts";
import { formatCount, formatScore } from "../lib/format.ts";
import { fill } from "../lib/template.ts";
import Icon from "./Icon.astro";
import VisuallyHidden from "./VisuallyHidden.astro";

type Props = {
  course: CollectionEntry<"courses">["data"];
};

// The score and the review count (DESIGN.md, Course rating line).
const { rating } = Astro.props.course;
const score = formatScore(rating.score);
const copy = await getHomeCopy();
const reviews = formatCount(rating.reviews, copy.reviewCount);
---

<VisuallyHidden>{fill(copy.rating, { score, reviews })}</VisuallyHidden>
<span class="rating" aria-hidden="true">
  <Icon name="star" size="sm" filled class="star" />
  <span class="score">{score}</span>
  {fill(copy.reviews, { reviews })}
</span>

<style>
  .rating {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .star {
    color: var(--text);
  }

  .score {
    color: var(--text);
    font-weight: var(--weight-medium);
  }
</style>
