---
import type { CollectionEntry } from "astro:content";
import { getHomeCopy } from "../lib/content.ts";
import { formatCount, formatMinutes, formatScore } from "../lib/format.ts";
import { fill } from "../lib/template.ts";
import Icon from "./Icon.astro";
import MetaItem from "./MetaItem.astro";
import MetaLine from "./MetaLine.astro";
import VisuallyHidden from "./VisuallyHidden.astro";

type Props = {
  course: CollectionEntry<"courses">["data"];
};

const { rating, lessons, minutes } = Astro.props.course;
const score = formatScore(rating.score);
const copy = await getHomeCopy();
const reviews = formatCount(rating.reviews, copy.reviewCount);
---

<MetaLine>
  <MetaItem>
    <VisuallyHidden>{fill(copy.rating, { score, reviews })}</VisuallyHidden>
    <span class="rating" aria-hidden="true">
      <Icon name="star" size="sm" class="star" />
      <span class="score">{score}</span>
      {fill(copy.reviews, { reviews })}
    </span>
  </MetaItem>
  <MetaItem>{formatCount(lessons, copy.lessonCount)}</MetaItem>
  <MetaItem>{formatMinutes(minutes)}</MetaItem>
</MetaLine>

<style>
  .rating {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .star {
    color: var(--text);
  }

  .score {
    color: var(--text);
    font-weight: var(--weight-medium);
  }
</style>
