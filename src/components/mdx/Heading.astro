---
import type { HTMLAttributes } from "astro/types";
import { getPostCopy } from "../../lib/content.ts";

type Props = HTMLAttributes<"h2">;

const { id, class: className } = Astro.props;
// GFM's own heading for the footnotes: hidden, with this id.
const footnotes = id === "footnote-label" && className === "sr-only";
// The anchor's name is a label followed by the heading, so each reads
// differently.
const label = `${String(id)}-anchor`;
const copy = await getPostCopy();
---

{footnotes ? (
  <h2 id={id} class="notes-label">
    {copy.footnotes}
  </h2>
) : (
  <div class="heading">
    <h2 id={id}>
      <slot />
    </h2>
    <a
      class="anchor"
      href={`#${String(id)}`}
      aria-labelledby={`${label} ${String(id)}`}
    >
      #
    </a>
    <span id={label} hidden>
      {copy.sectionLink}
    </span>
  </div>
)}

<style>
  /* The # link shows on hover and focus. */
  .heading {
    position: relative;

    h2 {
      font-size: var(--text-title);
      font-weight: var(--weight-semibold);
      line-height: var(--leading-tight);
      letter-spacing: var(--tracking-title);
    }

    @media (hover: hover) and (pointer: fine) {
      &:hover .anchor {
        opacity: 1;
      }
    }
  }

  .anchor {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: calc(-1 * var(--space-6));
    inline-size: var(--space-5);
    color: var(--text-3);
    font-size: var(--text-title);
    font-weight: var(--weight-medium);
    line-height: var(--leading-tight);
    opacity: 0;
    transition: opacity var(--dur-quick) var(--ease);

    &:focus-visible {
      opacity: 1;
    }
  }

  .notes-label {
    font-size: var(--text-subtitle);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-title);
  }
</style>
