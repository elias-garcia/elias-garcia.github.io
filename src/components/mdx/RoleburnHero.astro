---
type Props = {
  caption: string;
};

const { caption } = Astro.props;

// The drawing's labels: decorative, hidden from screen readers like the text
// inside the project illustrations. The caption describes it.
const listings = [
  { title: "Staff Frontend Engineer", place: "Remote, Europe", match: true },
  { title: "Senior iOS Engineer", place: "On-site, Berlin", match: false },
  { title: "Product Engineer, AI", place: "Remote, Europe", match: true },
  { title: "Frontend Developer", place: "Hybrid, Madrid", match: false },
  {
    title: "Senior Full-Stack Engineer",
    place: "Remote, US only",
    match: false,
  },
  { title: "Staff Engineer, Payments", place: "Remote, Europe", match: true },
  { title: "Data Engineer", place: "On-site, London", match: false },
  { title: "Junior React Developer", place: "Remote", match: false },
];
const criteria = [
  "Remote from Europe",
  "Senior and above",
  "TypeScript",
  "Web3",
  "Payments",
  "AI",
];
const matches = listings.filter(({ match }) => match).length;
---

<figure class="hero">
  <div class="drawing" aria-hidden="true">
    <div class="listings">
      <span class="scan"></span>
      {listings.map(({ title, place, match }) => (
        <span class:list={["listing", match ? "match" : "skip"]}>
          <span class="title">{title}</span>
          <span class="place">{place}</span>
        </span>
      ))}
    </div>
    <div class="aside">
      <div class="criteria">
        <span class="label">Criteria</span>
        <span class="chips">
          {criteria.map((criterion) => (
            <span class="chip">{criterion}</span>
          ))}
        </span>
      </div>
      <div class="digest">
        <span class="label">Today's digest</span>
        <span class="count">{matches} matches</span>
        <span class="note">
          out of {listings.length} new listings, each scored against the CV with
          a one-line reason.
        </span>
      </div>
    </div>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .drawing {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    overflow: hidden;
    padding: var(--space-6);
    border: var(--hairline) solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    view-transition-name: roleburn-preview;

    @media (width >= 40rem) {
      flex-direction: row;
    }
  }

  .listings {
    position: relative;
    display: flex;
    flex: 3 1 0;
    flex-direction: column;
    gap: var(--space-2);
    min-inline-size: 0;
  }

  /* The scan line sweeps from the first listing to just past the last one:
     the box covers the list, and moves by its own height plus a gap. */
  .scan {
    position: absolute;
    z-index: 1;
    inset-block: 0;
    inset-inline: calc(-1 * var(--space-3));

    &::before {
      content: "";
      display: block;
      block-size: var(--rule-strong);
      border-radius: var(--r-sm);
      background: var(--accent);
      box-shadow: var(--scan-glow);
    }
  }

  .listing {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-block-size: var(--hero-row);
    padding-inline: var(--space-4);
    border: var(--hairline) solid var(--line);
    border-radius: var(--r-md);
    background: var(--bg);
    font-size: var(--text-meta);
  }

  .title {
    overflow: hidden;
    font-weight: var(--weight-medium);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .place {
    color: var(--text-2);
    white-space: nowrap;
  }

  .aside {
    display: flex;
    flex: 2 1 0;
    flex-direction: column;
    gap: var(--space-5);
    min-inline-size: 0;
  }

  .criteria,
  .digest {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .label {
    color: var(--text-3);
    font-size: var(--text-meta);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--hero-chip);
    padding-inline: var(--space-3);
    border: var(--hairline) solid var(--line);
    border-radius: var(--r-full);
    background: var(--bg);
    color: var(--text-2);
    font-size: var(--text-micro);
  }

  .digest {
    padding: var(--space-4);
    border: var(--hairline) solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg);
  }

  .count {
    font-size: var(--text-figure);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-title);
  }

  .note {
    color: var(--text-2);
    font-size: var(--text-meta);
  }

  figcaption {
    color: var(--text-3);
    font-size: var(--text-meta);
  }

  @media (prefers-reduced-motion: no-preference) {
    .scan {
      animation: scan var(--dur-scan) var(--ease-scan) infinite;
    }

    .listing {
      animation: var(--dur-scan) var(--ease) infinite both;
    }

    .match {
      animation-name: lit;
    }

    .skip {
      animation-name: dim;
    }
  }

  @keyframes scan {
    from {
      opacity: 0;
      translate: 0 0;
    }

    4% {
      opacity: 1;
    }

    60% {
      opacity: 1;
      translate: 0 calc(100% + var(--space-2));
    }

    68%,
    to {
      opacity: 0;
      translate: 0 calc(100% + var(--space-2));
    }
  }

  @keyframes lit {
    4%,
    70% {
      border-color: var(--accent);
      background: var(--tint);
    }

    80%,
    to {
      border-color: var(--line);
      background: var(--bg);
    }
  }

  @keyframes dim {
    4%,
    70% {
      opacity: var(--hero-dim);
    }

    80%,
    to {
      opacity: 1;
    }
  }
</style>
