---
import { arrowTail, opensNewTab } from "../lib/links.ts";
import Icon from "./Icon.astro";
import NewTabNote from "./NewTabNote.astro";

// A link's label followed by the external arrow, which never starts a line:
// it stays with the end of the label (DESIGN.md, External-link arrow).
type Props = {
  href: string;
  label: string;
};

const { href, label } = Astro.props;
const { start, end } = arrowTail(label);
---

{start}
<span class="end">
  {end}
  <Icon name="arrow-up-right" size="sm" class="external" />
</span>
{opensNewTab(href) && <NewTabNote />}

<style>
  .end {
    white-space: nowrap;
  }

  .external {
    /* The nudge on hover, and the offset from the baseline. */
    --nudge-sm: 1px;

    display: inline-block;
    margin-inline-start: var(--space-1);
    vertical-align: calc(-1 * var(--nudge-sm));
    stroke: var(--text-3);
    transition: stroke var(--dur-quick) var(--ease);

    :global(a:focus-visible) & {
      stroke: currentColor;
    }

    @media (hover: hover) and (pointer: fine) {
      :global(a:hover) & {
        stroke: currentColor;
      }
    }

    @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
      transition:
        stroke var(--dur-quick) var(--ease),
        translate var(--dur-quick) var(--ease-settle);

      :global(a:hover) & {
        translate: var(--nudge-sm) calc(-1 * var(--nudge-sm));
      }
    }
  }
</style>
