---
import { getLayoutCopy } from "../lib/content.ts";

const { skip } = await getLayoutCopy();
---

<a class="skip" href="#content">
  {skip}
</a>

<style>
  .skip {
    /* Fixed, not absolute: hidden above the screen, it isn't drawn in the
       area a pull to refresh reveals above the page. */
    position: fixed;
    inset-block-start: var(--space-3);
    inset-inline-start: var(--space-3);
    z-index: var(--z-skip);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--r-full);
    background: var(--text);
    color: var(--bg);
    font-size: var(--text-small);
    translate: 0 calc(-100% - var(--space-6));

    @media (prefers-reduced-motion: no-preference) {
      transition: translate var(--dur-quick) var(--ease-settle);
    }

    &:focus {
      translate: 0 0;
    }
  }
</style>
