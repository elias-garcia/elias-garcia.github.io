---
import type { HTMLAttributes } from "astro/types";
import ArrowRight from "@tabler/icons-astro/icons/arrow-right";
import ArrowUpRight from "@tabler/icons-astro/icons/arrow-up-right";
import BrandGithub from "@tabler/icons-astro/icons/brand-github";
import BrandLinkedin from "@tabler/icons-astro/icons/brand-linkedin";
import BrandX from "@tabler/icons-astro/icons/brand-x";
import ChevronDown from "@tabler/icons-astro/icons/chevron-down";
import ChevronLeft from "@tabler/icons-astro/icons/chevron-left";
import ChevronRight from "@tabler/icons-astro/icons/chevron-right";
import CornerDownLeft from "@tabler/icons-astro/icons/corner-down-left";
import Download from "@tabler/icons-astro/icons/download";
import FileText from "@tabler/icons-astro/icons/file-text";
import Hash from "@tabler/icons-astro/icons/hash";
import LayoutGrid from "@tabler/icons-astro/icons/layout-grid";
import Link from "@tabler/icons-astro/icons/link";
import Mail from "@tabler/icons-astro/icons/mail";
import Markdown from "@tabler/icons-astro/icons/markdown";
import PlayerPlay from "@tabler/icons-astro/icons/player-play";
import Plus from "@tabler/icons-astro/icons/plus";
import Rss from "@tabler/icons-astro/icons/rss";
import Search from "@tabler/icons-astro/icons/search";
import Star from "@tabler/icons-astro/icons/star";
import World from "@tabler/icons-astro/icons/world";
import X from "@tabler/icons-astro/icons/x";

// Every icon, under its Tabler name (DESIGN.md §2.7). Decorative: the
// control or link it sits in carries the name.
const icons = {
  "arrow-right": ArrowRight,
  "arrow-up-right": ArrowUpRight,
  "brand-github": BrandGithub,
  "brand-linkedin": BrandLinkedin,
  "brand-x": BrandX,
  "chevron-down": ChevronDown,
  "chevron-left": ChevronLeft,
  "chevron-right": ChevronRight,
  "corner-down-left": CornerDownLeft,
  download: Download,
  "file-text": FileText,
  hash: Hash,
  "layout-grid": LayoutGrid,
  link: Link,
  mail: Mail,
  markdown: Markdown,
  "player-play": PlayerPlay,
  plus: Plus,
  rss: Rss,
  search: Search,
  star: Star,
  world: World,
  x: X,
};

// The width and height attributes, for a page whose styles haven't loaded
// (Tabler writes 24 otherwise): the same sizes as --icon-md and --icon-sm.
const pixels = { md: 16, sm: 12 };

// What a component may pass on to the <svg>. Without the icon's own props,
// and without `color`, `stroke` and `title`, which Tabler reads as props.
type Props = Omit<
  HTMLAttributes<"svg">,
  "name" | "size" | "color" | "stroke" | "stroke-width" | "title"
> & {
  name: keyof typeof icons;
  size?: "md" | "sm";
  filled?: boolean;
};

const {
  name,
  size = "md",
  filled = false,
  class: className,
  ...attributes
} = Astro.props;
const Tabler = icons[name];
---

<Tabler
  class:list={[{ sm: size === "sm", filled }, className]}
  size={pixels[size]}
  stroke={1.5}
  aria-hidden="true"
  {...attributes}
/>

<style>
  /* Tabler puts tabler-icon and tabler-icon-<name> on every icon. :where()
     keeps these below whatever the component using the icon sets. */
  :where(.tabler-icon) {
    flex: none;
    inline-size: var(--icon-md);
    block-size: var(--icon-md);
  }

  /* The stroke stays 1.5px at 16 and 12px instead of scaling with the 24px
     drawing. Tabler has no prop for it. */
  :where(.tabler-icon) :global(*) {
    vector-effect: non-scaling-stroke;
  }

  :where(.sm) {
    inline-size: var(--icon-sm);
    block-size: var(--icon-sm);
  }

  :where(.filled) {
    fill: currentColor;
  }

  /* The RSS icon's dot, its first path, is a dot, not a ring. It keeps its
     stroke: without it the dot is too small for the arcs (DESIGN.md §2.7). */
  :where(.tabler-icon-rss) :global(path:first-child) {
    fill: currentColor;
  }
</style>
