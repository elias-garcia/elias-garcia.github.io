---
// A key, shown as a hint. Never focusable, and hidden from screen readers:
// the controls it belongs to say what the key does.
---

<kbd class="key" aria-hidden="true">
  <slot />
</kbd>

<style>
  .key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--kbd-min);
    min-block-size: var(--kbd-min);
    padding-inline: var(--space-1);
    border: var(--hairline) solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg);
    color: var(--text-2);
    font: inherit;
    font-size: var(--text-micro);
    line-height: var(--leading-none);
    -webkit-user-select: none;
    user-select: none;
  }
</style>
