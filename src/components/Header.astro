---
import { currentState, sections } from "../lib/navigation.ts";
import Logo from "./Logo.astro";
import SearchButton from "./SearchButton.astro";

type Props = {
  name: string;
  readingProgress: boolean;
};

const { name, readingProgress } = Astro.props;
const { pathname } = Astro.url;
---

<header class="header">
  <div class="bar">
    <a class="home" href="/" aria-label={`${name}, home`}>
      <Logo size="md" />
    </a>
    <nav aria-label="Main">
      <ul class="links" role="list">
        {sections.map(({ label, href }) => (
          <li>
            <a
              class="link"
              href={href}
              aria-current={currentState(href, pathname)}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <SearchButton />
    </nav>
  </div>
  {readingProgress && <div class="progress" aria-hidden="true" />}
</header>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    border-block-end: var(--hairline) solid var(--line);
    background: var(--header-bg);
    backdrop-filter: var(--header-backdrop);
    view-transition-name: site-header;

    /* While a photo travels into the image viewer or out of it, the header
       stays part of the page, under the viewer's backdrop. */
    :global(:root[data-viewer-travel]) & {
      view-transition-name: none;
    }
  }

  /* Grows with the page's scroll, where scroll-driven animations exist. */
  .progress {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .progress {
        display: block;
        position: absolute;
        inset-inline: 0;
        inset-block-end: calc(-1 * var(--hairline));
        block-size: var(--progress-h);
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: 0 50%;
        /* Longhands: the build's CSS minifier folds animation-timeline into
           the animation shorthand, which browsers then reject. */
        animation-name: grow;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
      }
    }
  }

  /* Empty until the page scrolls: a page too short to scroll keeps it at 0. */
  @keyframes grow {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-inline-size: var(--column);
    min-block-size: var(--bar-h);
    margin-inline: auto;
    padding-inline: var(--page-start) var(--page-end);
  }

  .home {
    display: flex;
    align-items: center;
    min-block-size: var(--hit-area);
  }

  nav,
  .links {
    display: flex;
    align-items: center;
    gap: var(--space-6);

    @media (width < 40rem) {
      gap: var(--space-4);
    }
  }

  .link {
    position: relative;
    display: inline-block;
    color: var(--text-2);
    transition: color var(--dur) var(--ease);

    @media (hover: hover) and (pointer: fine) {
      &:hover {
        color: var(--text);
      }
    }

    &[aria-current] {
      color: var(--accent);
    }

    &:focus-visible {
      border-radius: var(--r-sm);
    }

    &::after {
      content: "";
      position: absolute;
      inset-inline: 0;
      inset-block-end: calc(-1 * var(--space-1));
      block-size: var(--hairline);
      background: currentColor;
      opacity: 0;
    }

    &[aria-current]::after {
      opacity: 1;
    }

    @media (hover: hover) and (pointer: fine) {
      &::after {
        transition: opacity var(--dur) var(--ease-settle);
      }

      &:hover::after {
        opacity: 1;
      }
    }
  }

  /* currentColor isn't a system colour, so forced colours would drop the
     underline. */
  @media (forced-colors: active) {
    .link::after {
      background: LinkText;
    }
  }
</style>
