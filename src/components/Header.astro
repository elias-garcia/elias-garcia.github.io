---
import { getLayoutCopy } from "../lib/content.ts";
import { currentState } from "../lib/navigation.ts";
import { routes } from "../lib/routes.ts";
import { getSections } from "../lib/sections.ts";
import { fill } from "../lib/template.ts";
import Logo from "./Logo.astro";
import SearchButton from "./SearchButton.astro";

type Props = {
  name: string;
  readingProgress: boolean;
};

const { name, readingProgress } = Astro.props;
const { pathname } = Astro.url;
const [copy, sections] = await Promise.all([getLayoutCopy(), getSections()]);
---

<header class="header">
  <div class="bar">
    <a
      class="home"
      href={routes.home}
      aria-label={fill(copy.homeName, { name })}
    >
      <Logo size="md" />
    </a>
    {/* Home alone, the page it would point to, is no navigation. */}
    {sections.length > 1 ? (
      <nav aria-label={copy.navName}>
        <ul class="links" role="list">
          {sections.map(({ label, href }) => (
            <li>
              <a
                class="link"
                href={href}
                aria-current={currentState(href, pathname)}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
        <SearchButton />
      </nav>
    ) : (
      <SearchButton />
    )}
  </div>
  {readingProgress && <div class="progress" aria-hidden="true" />}
</header>

<style>
  .header {
    --header-backdrop: saturate(1.4) blur(12px);
    --progress-h: 2px;
    --nav-gap: var(--space-6);

    @media (width < 40rem) {
      --nav-gap: var(--space-4);
    }

    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    border-block-end: var(--hairline) solid var(--line);
    background: var(--header-bg);
    backdrop-filter: var(--header-backdrop);
    view-transition-name: site-header;

    /* While a photo travels into the image viewer or out of it, the header
       stays part of the page, under the viewer's backdrop. */
    :global(:root[data-viewer-travel]) & {
      view-transition-name: none;
    }
  }

  /* Grows with the page's scroll, where scroll-driven animations exist. */
  .progress {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .progress {
        display: block;
        position: absolute;
        inset-inline: 0;
        inset-block-end: calc(-1 * var(--hairline));
        block-size: var(--progress-h);
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: 0 50%;
        /* Longhands: the build's CSS minifier folds animation-timeline into
           the animation shorthand, which browsers then reject. */
        animation-name: grow;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
      }
    }
  }

  /* Empty until the page scrolls: a page too short to scroll keeps it at 0. */
  @keyframes grow {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-inline-size: var(--column);
    min-block-size: var(--bar-h);
    margin-inline: auto;
    padding-inline: var(--page-start) var(--page-end);
  }

  .home {
    position: relative;
    display: flex;
    align-items: center;
    min-block-size: var(--hit-area);
  }

  /* The logo and the links take a click anywhere in the bar's height, and
     the links up to halfway into the gaps beside them, so a fast click just
     off one still lands on the nearest; how they look doesn't change. */
  .home::before,
  .link::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-start: 50%;
    block-size: var(--bar-h);
    translate: 0 -50%;
  }

  .link::before {
    inset-inline: calc(var(--nav-gap) / -2);
  }

  nav,
  .links {
    display: flex;
    align-items: center;
    gap: var(--nav-gap);
  }

  .link {
    position: relative;
    display: inline-block;
    color: var(--text-2);
    transition: color var(--dur) var(--ease);

    @media (hover: hover) and (pointer: fine) {
      &:hover {
        color: var(--text);
      }
    }

    &[aria-current] {
      color: var(--accent);
    }

    &::after {
      content: "";
      position: absolute;
      inset-inline: 0;
      inset-block-end: calc(-1 * var(--space-1));
      block-size: var(--hairline);
      background: currentColor;
      opacity: 0;
    }

    &[aria-current]::after {
      opacity: 1;
    }

    @media (hover: hover) and (pointer: fine) {
      &::after {
        transition: opacity var(--dur) var(--ease-settle);
      }

      &:hover::after {
        opacity: 1;
      }
    }
  }

  /* currentColor isn't a system colour, so forced colours would drop the
     underline. */
  @media (forced-colors: active) {
    .link::after {
      background: LinkText;
    }
  }
</style>
